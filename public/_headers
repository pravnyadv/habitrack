# Cache-Control for the static assets Pages serves directly (everything in
# dist/_routes.json's "exclude" list). SSR pages come from the Worker and set their
# own headers, so they are not affected by this file.
#
# Why this exists: Cloudflare Pages defaults every static asset to
# `max-age=0, must-revalidate`. That made every cold launch of the installed PWA
# revalidate the CSS and the JS bundle over the network before it could paint, which
# is most of the multi-second white screen on a phone whose radio just woke up.

# Build output is content-hashed (the filename changes whenever the bytes do), so a
# stale entry can never be served for new content. Cache it hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must stay revalidatable. Cache it and a broken SW can never be
# replaced, because the SW is what controls everything else.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# The offline fallback is precached by the SW anyway; keep the network copy fresh.
/offline.html
  Cache-Control: public, max-age=0, must-revalidate

# These have stable filenames, so they can't be immutable, but they change rarely.
# An hour on the manifest and a day on the icons: still nearly always a cache hit on
# a cold launch, and a rename is visible within a day.
/manifest.webmanifest
  Cache-Control: public, max-age=3600
/icon.svg
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# iOS launch images. A device only ever fetches the one whose media query matches.
/splash/*
  Cache-Control: public, max-age=86400
