{
  // Pages projects do NOT support account_id here, so the account comes from
  // CLOUDFLARE_ACCOUNT_ID, which the npm "deploy" script requires to be set.
  "name": "habitrack",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist"
}
