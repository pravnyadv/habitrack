---
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import Manage from '../../components/profile/Manage.jsx';
import { getSql, listProfiles, getProfile, listShareViewers, listPresence } from '../../lib/db.js';

// Middleware gates this route and hands over the verified id, so there's no
// second verifyToken here. The three independent reads go out in parallel —
// each Neon call is its own HTTP round trip.
const env = Astro.locals.runtime?.env;
const sql = getSql(env);
const pid = Astro.locals.profileId;
if (!pid) return Astro.redirect('/profile');

const [p, profiles, shared] = await Promise.all([
  getProfile(sql, pid),
  listProfiles(sql),
  listShareViewers(sql, pid),
]);
if (!p) return Astro.redirect('/profile');
const me = { id: p.id, name: p.name, admin: !!p.is_admin };

let presence = null;
if (me.admin) {
  const rows = await listPresence(sql, 120);
  presence = { online: rows.filter((r) => r.online).length, profiles: rows };
}
---

<ProfileLayout pageTitle="Manage profile — Habitrack" heading="Profile" tab="manage" backHref="/">
  <Manage client:load me={me} profiles={profiles} shares={{ shared }} presence={presence} />
</ProfileLayout>
