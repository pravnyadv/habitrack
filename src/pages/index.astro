---
import '../styles/global.css';
// No server-side data fetch: the app is passcode-gated and loads habits
// client-side (with the passcode header) so the HTML never contains data.
const today = new Date().toLocaleDateString('en-US', {
  weekday: 'long', month: 'long', day: 'numeric',
});
---

<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Habitrack — build better habits</title>
    <meta name="description" content="A simple, beautiful habit tracker." />
    <meta name="robots" content="noindex, nofollow" />

    <!-- PWA / iOS home-screen -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Habitrack" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply theme before paint to avoid flash
      const t = localStorage.getItem('theme');
      if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="h-full bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 font-sans antialiased">

    <!-- Profile gate: covers everything until a profile is unlocked -->
    <div id="gate" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-50 px-6 dark:bg-slate-950">
      <div class="w-full max-w-xs text-center">
        <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-500 text-3xl shadow-sm">🦫</div>
        <h1 class="text-lg font-bold">Habitrack</h1>

        <!-- Login view: selected profile + passcode -->
        <form id="login-form" class="mt-5 hidden">
          <p class="mb-3 text-sm text-slate-500 dark:text-slate-400">
            <span id="login-profile-name" class="font-semibold text-slate-700 dark:text-slate-200"></span>
            <button type="button" id="switch-profile" class="ml-1 text-emerald-600 hover:underline dark:text-emerald-400">Change</button>
          </p>
          <input id="login-passcode" type="password" inputmode="text" autocomplete="current-password"
            placeholder="Passcode" aria-label="Passcode"
            class="h-11 w-full rounded-xl border border-slate-200 bg-white px-4 text-center text-sm outline-none focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-900" />
          <p id="login-error" class="mt-2 hidden text-xs font-medium text-rose-500">Wrong passcode — try again.</p>
          <button type="submit"
            class="mt-4 h-11 w-full rounded-xl bg-emerald-500 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600 active:scale-95">Unlock</button>
        </form>

        <!-- Picker view: choose a profile -->
        <div id="picker-view" class="mt-5 hidden">
          <p class="mb-3 text-sm text-slate-500 dark:text-slate-400">Choose a profile</p>
          <div id="profile-list" class="flex flex-col gap-2"></div>
          <button type="button" id="new-profile-btn"
            class="mt-3 flex w-full items-center justify-center gap-1.5 rounded-xl border border-dashed border-slate-300 py-2.5 text-sm font-medium text-slate-500 transition hover:border-slate-400 hover:text-slate-700 dark:border-slate-700 dark:text-slate-400">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            New profile
          </button>
          <button type="button" id="manage-btn" class="mt-3 hidden text-xs font-medium text-slate-500 hover:underline dark:text-slate-400">Manage my profile</button>
          <button type="button" id="picker-cancel" class="mt-3 hidden text-xs text-slate-400 hover:underline">Cancel</button>
        </div>

        <!-- Manage view (rename / change passcode / delete the signed-in profile) -->
        <div id="manage-view" class="mt-5 hidden text-left">
          <p class="mb-3 text-center text-sm text-slate-500 dark:text-slate-400">Manage <span id="manage-name" class="font-semibold text-slate-700 dark:text-slate-200"></span></p>
          <label class="mb-1 block text-[11px] font-medium text-slate-400">Profile name</label>
          <div class="mb-4 flex gap-2">
            <input id="manage-rename" autocomplete="off" aria-label="Profile name"
              class="h-10 flex-1 rounded-xl border border-slate-200 bg-white px-3 text-sm outline-none focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-900" />
            <button type="button" id="manage-rename-save" class="h-10 shrink-0 rounded-xl bg-slate-100 px-3 text-xs font-semibold text-slate-700 transition hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Save</button>
          </div>
          <label class="mb-1 block text-[11px] font-medium text-slate-400">Change passcode</label>
          <input id="manage-cur-pass" type="password" autocomplete="current-password" placeholder="Current passcode" aria-label="Current passcode"
            class="mb-2 h-10 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm outline-none focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-900" />
          <div class="flex gap-2">
            <input id="manage-new-pass" type="password" autocomplete="new-password" placeholder="New passcode (4+)" aria-label="New passcode"
              class="h-10 flex-1 rounded-xl border border-slate-200 bg-white px-3 text-sm outline-none focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-900" />
            <button type="button" id="manage-pass-save" class="h-10 shrink-0 rounded-xl bg-slate-100 px-3 text-xs font-semibold text-slate-700 transition hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Change</button>
          </div>
          <p id="manage-msg" class="mt-2 hidden text-xs font-medium"></p>
          <button type="button" id="manage-delete" class="mt-5 w-full rounded-xl py-2.5 text-sm font-medium text-rose-500 transition hover:bg-rose-50 dark:hover:bg-rose-950/40">Delete this profile</button>
          <button type="button" id="manage-back" class="mt-2 block w-full text-center text-xs text-slate-400 hover:underline">Back</button>
        </div>

        <!-- Create view -->
        <form id="create-form" class="mt-5 hidden">
          <p class="mb-3 text-sm text-slate-500 dark:text-slate-400">Create a profile</p>
          <input id="create-name" placeholder="Profile name" autocomplete="off" aria-label="Profile name"
            class="mb-2 h-11 w-full rounded-xl border border-slate-200 bg-white px-4 text-center text-sm outline-none focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-900" />
          <input id="create-passcode" type="password" inputmode="text" autocomplete="new-password" placeholder="Choose a passcode (4+ chars)" aria-label="Passcode"
            class="h-11 w-full rounded-xl border border-slate-200 bg-white px-4 text-center text-sm outline-none focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-900" />
          <p id="create-error" class="mt-2 hidden text-xs font-medium text-rose-500"></p>
          <button type="submit"
            class="mt-4 h-11 w-full rounded-xl bg-emerald-500 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600 active:scale-95">Create & enter</button>
          <button type="button" id="create-back" class="mt-2 text-xs text-slate-400 hover:underline">Back</button>
        </form>
      </div>
    </div>

    <!-- Delete confirmation -->
    <div id="confirm-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 px-6 backdrop-blur-sm">
      <div class="w-full max-w-xs rounded-2xl bg-white p-5 shadow-xl dark:bg-slate-900">
        <p class="text-base font-semibold">Delete habit?</p>
        <p id="confirm-text" class="mt-1.5 text-sm text-slate-500 dark:text-slate-400"></p>
        <div class="mt-5 flex gap-2">
          <button id="confirm-cancel" class="h-10 flex-1 rounded-xl bg-slate-100 text-sm font-semibold text-slate-700 transition hover:bg-slate-200 active:scale-95 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Cancel</button>
          <button id="confirm-delete" class="h-10 flex-1 rounded-xl bg-rose-500 text-sm font-semibold text-white transition hover:bg-rose-600 active:scale-95">Delete</button>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-2xl px-4 pb-24 pt-8 sm:pt-12">

      <!-- Header -->
      <header class="mb-8 flex items-center justify-between">
        <div>
          <h1 class="flex items-center gap-2 text-2xl font-bold tracking-tight">
            <span class="text-3xl">🦫</span> Habitrack
            <button id="add-btn" aria-label="New habit" title="New habit"
              class="ml-1 flex h-8 w-8 items-center justify-center rounded-full bg-emerald-500 text-white shadow-sm transition hover:bg-emerald-600 active:scale-90">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2.4" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            </button>
          </h1>
          <div class="mt-1 flex items-center gap-2">
            <p class="text-sm text-slate-500 dark:text-slate-400">{today}</p>
            <button id="profile-chip" title="Switch profile"
              class="hidden items-center gap-1 rounded-full bg-slate-100 py-0.5 pl-2 pr-1.5 text-xs font-medium text-slate-600 transition hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.25a7.5 7.5 0 0 1 15 0" /></svg>
              <span id="profile-chip-name"></span>
              <svg class="h-3 w-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
            </button>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button id="install-btn" aria-label="Install app" title="Install app"
            class="hidden items-center justify-center rounded-xl border border-emerald-200 bg-emerald-50 p-2.5 text-emerald-600 shadow-sm transition hover:bg-emerald-100 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-400">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
          </button>
          <a href="/overview" aria-label="Overview" title="Overview"
            class="rounded-xl border border-slate-200 bg-white p-2.5 text-slate-500 shadow-sm transition hover:text-slate-900 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400 dark:hover:text-white">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" /></svg>
          </a>
          <button id="theme-toggle" aria-label="Toggle theme"
            class="rounded-xl border border-slate-200 bg-white p-2.5 text-slate-500 shadow-sm transition hover:text-slate-900 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400 dark:hover:text-white">
            <svg class="hidden h-5 w-5 dark:block" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" /></svg>
            <svg class="block h-5 w-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" /></svg>
          </button>
        </div>
      </header>

      <div id="load-error" class="mb-6 hidden rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700 dark:border-rose-900 dark:bg-rose-950/50 dark:text-rose-300">
        Couldn't reach the server. Check your connection and reload.
      </div>

      <!-- Today progress -->
      <section id="today-card" class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Today's progress</p>
            <p id="today-count" class="mt-0.5 text-2xl font-bold tabular-nums">0 / 0</p>
          </div>
          <div id="today-ring" class="relative h-16 w-16">
            <svg class="h-16 w-16 -rotate-90" viewBox="0 0 36 36">
              <circle cx="18" cy="18" r="15.5" fill="none" class="stroke-slate-100 dark:stroke-slate-800" stroke-width="4" />
              <circle id="today-progress" cx="18" cy="18" r="15.5" fill="none" class="stroke-emerald-500" stroke-width="4" stroke-linecap="round" stroke-dasharray="97.4" stroke-dashoffset="97.4" style="transition: stroke-dashoffset .5s ease" />
            </svg>
            <span id="today-pct" class="absolute inset-0 flex items-center justify-center text-sm font-semibold tabular-nums">0%</span>
          </div>
        </div>
      </section>

      <!-- Add habit (toggled by the + in the header) -->
      <form id="habit-form" class="mb-6 hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-center gap-2">
          <input id="habit-emoji" name="emoji" maxlength="2" value="✅" aria-label="Emoji"
            class="h-11 w-12 shrink-0 rounded-xl border border-slate-200 bg-slate-50 text-center text-xl outline-none focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-800" />
          <input id="habit-name" name="name" placeholder="e.g. Morning run" autocomplete="off" required
            class="h-11 flex-1 rounded-xl border border-slate-200 bg-slate-50 px-3.5 text-sm outline-none focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-800" />
          <button type="submit"
            class="h-11 shrink-0 rounded-xl bg-emerald-500 px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600 active:scale-95">Add</button>
        </div>
        <div id="color-picker" class="mt-3 flex flex-wrap gap-2"></div>
        <div class="mt-4">
          <p class="mb-1.5 text-xs font-medium text-slate-500 dark:text-slate-400">How often?</p>
          <div id="freq-seg" class="flex gap-1.5"></div>
          <div id="freq-days" class="mt-2 hidden flex-wrap gap-1.5"></div>
        </div>
      </form>

      <!-- Weekday header -->
      <div id="week-header" class="mb-2 px-4"></div>

      <!-- Habit list -->
      <main id="habit-list" class="space-y-2"></main>

      <p id="empty-state" class="hidden py-16 text-center text-sm text-slate-400 dark:text-slate-500">
        No habits yet — add your first one above ✨
      </p>
    </div>

    <script>
      import { COLORS, COLORS_DARK, MONTHS, WD, TODAY, iso, pad2, addDays, dow, schedOf, stats, windowStart, heatmapBlock, githubGraph, escapeHtml, connectRealtime } from '../lib/compute.js';

      // ---- constants ---------------------------------------------------------
      const EMOJIS = ['✅','💧','📖','🏃','🧘','💪','🥗','😴','✍️','🎯','☀️','🎸','💊','🚭','📵'];

      let habits = [];
      const expanded = new Set();

      // ---- auth: signed token + selected profile (both in localStorage) ------
      const TK = 'habitrack_token';
      const PID = 'habitrack_profile';
      let token = localStorage.getItem(TK) || '';
      let profile = null; // { id, name }
      try { profile = JSON.parse(localStorage.getItem(PID) || 'null'); } catch {}
      let socketId = null; // our realtime socket, sent so the server excludes us
      const authHeaders = (extra) => ({
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
        ...(socketId ? { 'x-socket-id': socketId } : {}),
        ...extra,
      });

      // ---- rendering ---------------------------------------------------------
      const list = document.getElementById('habit-list');
      const weekHead = document.getElementById('week-header');

      // Mobile: 7 equal columns — the name sits on its own full-width row above
      // the checks. Desktop (sm+): name column + 7 fixed day columns on one row.
      const GRID = 'grid grid-cols-7 gap-y-1 sm:grid-cols-[minmax(0,1fr)_repeat(7,2.25rem)] sm:gap-y-0 items-center';
      const last7 = () => Array.from({ length: 7 }, (_, i) => addDays(TODAY, i - 6));

      const CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px]"><path d="M4.5 12.75l6 6 9-13.5"/></svg>';
      const CROSS = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M6 18L18 6M6 6l12 12"/></svg>';
      const FLAME = '<svg viewBox="0 0 24 24" fill="currentColor" class="h-3 w-3"><path d="M12.963 2.286a.75.75 0 0 0-1.071-.136 9.742 9.742 0 0 0-3.539 6.177A7.547 7.547 0 0 1 6.648 6.61a.75.75 0 0 0-1.152-.081A9 9 0 1 0 15.68 4.534a7.46 7.46 0 0 1-2.717-2.248Z"/><path d="M15.75 14.25a3.75 3.75 0 1 1-7.313-1.172c.628.465 1.35.81 2.133 1.005a5.99 5.99 0 0 1 1.925-3.547 3.75 3.75 0 0 1 3.255 3.714Z"/></svg>';

      function weekHeader() {
        const cols = last7().map((d) => {
          const dd = new Date(d + 'T00:00:00');
          const isToday = d === TODAY;
          return `<div class="flex flex-col items-center leading-tight ${isToday ? 'text-slate-900 dark:text-white' : 'text-slate-400 dark:text-slate-500'}">
              <span class="text-[11px] font-medium">${dd.toLocaleDateString('en-US', { weekday: 'short' })}</span>
              <span class="text-[11px] ${isToday ? 'font-semibold' : ''}">${dd.getDate()}</span>
            </div>`;
        }).join('');
        // leading empty cell only exists on desktop (name column)
        weekHead.innerHTML = `<div class="${GRID}"><span class="hidden sm:block"></span>${cols}</div>`;
      }

      const REST = '<span class="h-1 w-1 rounded-full bg-slate-200 dark:bg-slate-700"></span>';
      function weekCells(habit) {
        const set = new Set(habit.days);
        const sched = schedOf(habit);
        const color = COLORS[habit.color] || COLORS.emerald;
        return last7().map((d) => {
          const isToday = d === TODAY;
          if (!sched.has(dow(d))) {
            // rest day — not tracked, not clickable
            return `<div class="flex h-9 items-center justify-center opacity-70" title="${d} · rest day">${REST}</div>`;
          }
          const done = set.has(d);
          return `<button data-day="${d}" data-habit="${habit.id}"
              class="day flex h-9 items-center justify-center rounded-lg transition hover:bg-slate-50 active:scale-90 dark:hover:bg-slate-800/60 ${isToday ? 'bg-slate-50/70 dark:bg-slate-800/40' : ''}"
              title="${d}${done ? ' · done' : ''}"
              style="${done ? `color:${color}` : ''}">
              <span class="${done ? '' : 'text-slate-300 dark:text-slate-600'}">${done ? CHECK : CROSS}</span>
            </button>`;
        }).join('');
      }

      // ---- LEVEL 1: single-month calendar (current month by default) ---------
      const calView = new Map(); // habitId -> {y, m} of the month being viewed
      function getCalView(id) {
        if (!calView.has(id)) {
          const d = new Date(TODAY + 'T00:00:00');
          calView.set(id, { y: d.getFullYear(), m: d.getMonth() });
        }
        return calView.get(id);
      }

      function calendarGrid(habit) {
        const { y, m } = getCalView(habit.id);
        const set = new Set(habit.days);
        const sched = schedOf(habit);
        const color = COLORS[habit.color] || COLORS.emerald;
        const colorDark = COLORS_DARK[habit.color] || COLORS_DARK.emerald;
        const t = new Date(TODAY + 'T00:00:00');
        const atCurrent = (y === t.getFullYear() && m === t.getMonth());
        const monthLabel = new Date(y, m, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

        const firstDow = (new Date(y, m, 1).getDay() + 6) % 7; // Mon=0
        const daysInMonth = new Date(y, m + 1, 0).getDate();

        // habit's active-from date = earlier of created date / first check-in.
        // Nothing before this can be "missed" — the habit didn't exist yet.
        const firstCheckin = habit.days.length ? habit.days.reduce((a, b) => (a < b ? a : b)) : null;
        const created = (habit.created_at || '').slice(0, 10) || null;
        const activeFrom = (firstCheckin && created) ? (firstCheckin < created ? firstCheckin : created) : (firstCheckin || created);

        // Weekday headers: medium/secondary gray structural labels.
        const wdRow = WD.map((w) => `<div class="text-center text-[11px] font-medium text-slate-500 dark:text-slate-400">${w}</div>`).join('');

        // Hybrid streak-tile calendar. Each cell is an aspect-square grid slot;
        // an absolutely-centered inner "tile" carries the fill, the number sits
        // centered on top. Columns touch (gap-x-0) so full-width done tiles form
        // one continuous capsule; corners square on any side that abuts another
        // done day (same-row link or row-wrap), rounded otherwise.
        const R = 12;                        // outer corner radius (px)
        const HGT = '78%';                   // tile height within the square cell
        const tint = `${color}20`;           // ~12% tint of the habit color (missed)
        const CTR = 'absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2';
        // done numbers are 500 (heavier); every other state is 400 — weight is
        // added per-state below, not baked into NUM.
        const NUM = `${CTR} z-10 text-sm tabular-nums`;

        let cells = '';
        for (let i = 0; i < firstDow; i++) cells += '<div></div>';
        for (let d = 1; d <= daysInMonth; d++) {
          const ds = `${y}-${pad2(m + 1)}-${pad2(d)}`;
          const future = ds > TODAY;
          const beforeActive = activeFrom && ds < activeFrom;
          const scheduled = sched.has(new Date(y, m, d).getDay());
          const done = set.has(ds);
          const isToday = ds === TODAY;

          if (done) {
            // square the side that abuts another done day; full-width when linked
            const leftSq = set.has(addDays(ds, -1));
            const rightSq = set.has(addDays(ds, 1));
            const full = leftSq || rightSq;
            const br = `${leftSq ? 0 : R}px ${rightSq ? 0 : R}px ${rightSq ? 0 : R}px ${leftSq ? 0 : R}px`;
            const fill = `<span class="${CTR}" style="width:${full ? '100%' : '80%'};height:${HGT};background:${color};border-radius:${br}"></span>`;
            cells += `<button data-day="${ds}" data-habit="${habit.id}" class="day relative aspect-square transition active:opacity-70" title="${ds} · done">${fill}<span class="${NUM} font-medium text-white">${d}</span></button>`;
          } else if (isToday && scheduled) {
            // today, not done — transparent tile with an inset ring in habit color
            const fill = `<span class="${CTR}" style="width:80%;height:${HGT};border-radius:${R}px;box-shadow:inset 0 0 0 1.5px ${color}"></span>`;
            cells += `<button data-day="${ds}" data-habit="${habit.id}" class="day relative aspect-square transition active:opacity-70" title="${ds}">${fill}<span class="${NUM} font-normal" style="color:${colorDark}">${d}</span></button>`;
          } else if (scheduled && !future && !beforeActive) {
            // missed (past, active, scheduled, not done) — light tint, discrete tile
            const fill = `<span class="${CTR}" style="width:80%;height:${HGT};background:${tint};border-radius:10px"></span>`;
            cells += `<button data-day="${ds}" data-habit="${habit.id}" class="day relative aspect-square transition active:opacity-70" title="${ds} · missed">${fill}<span class="${NUM} font-normal" style="color:${colorDark}">${d}</span></button>`;
          } else {
            // before-created / future / rest day — no fill, legible-but-subordinate
            // gray. The ONLY state that uses gray (never a global default).
            cells += `<div class="relative flex aspect-square items-center justify-center text-sm font-normal tabular-nums text-slate-500 dark:text-slate-400">${d}</div>`;
          }
        }

        const arrowBtn = (dir, attr) => `<button ${attr} aria-label="${dir === 'prev' ? 'Previous' : 'Next'} month"
            class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="${dir === 'prev' ? 'M15.75 19.5 8.25 12l7.5-7.5' : 'm8.25 4.5 7.5 7.5-7.5 7.5'}"/></svg>
          </button>`;

        const legend = `<div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] text-slate-500 dark:text-slate-400">
            <span class="flex items-center gap-1.5"><span class="inline-block h-3 w-6 rounded-full" style="background:${color}"></span>Streak</span>
            <span class="flex items-center gap-1.5"><span class="inline-block h-3.5 w-3.5 rounded" style="background:${tint}"></span>Missed</span>
            <span class="flex items-center gap-1.5"><span class="inline-block h-3.5 w-3.5 rounded" style="box-shadow:inset 0 0 0 1.5px ${color}"></span>Today</span>
          </div>`;

        // Cap the calendar footprint (~70% of full width) so the tiles are ~30%
        // more compact. Cells shrink uniformly; inner-tile percentages are
        // unchanged, so connected done-tiles stay 100%-of-cell and still touch.
        return `
          <div class="mx-auto max-w-[420px]">
            <div class="mb-3 flex items-center justify-between">
              ${arrowBtn('prev', `data-cal-prev="${habit.id}"`)}
              <span class="text-sm font-semibold">${monthLabel}</span>
              ${atCurrent ? '<span class="h-8 w-8" aria-hidden="true"></span>' : arrowBtn('next', `data-cal-next="${habit.id}"`)}
            </div>
            <div class="grid grid-cols-7 gap-x-0">${wdRow}</div>
            <div class="mt-1 grid grid-cols-7 gap-x-0 gap-y-[5px]">${cells}</div>
            ${legend}
          </div>`;
      }

      // ---- expanded panel: overview (calendar) + optional stats -------------
      function overviewPanel(habit) {
        const s = stats(habit);
        const cell = (label, val) => `
          <div class="rounded-xl bg-slate-50 px-3 py-2.5 text-center dark:bg-slate-800/50">
            <div class="text-lg font-bold tabular-nums">${val}</div>
            <div class="text-[11px] font-medium text-slate-500 dark:text-slate-400">${label}</div>
          </div>`;

        return `
          <div class="mt-5 border-t border-slate-100 pt-5 dark:border-slate-800">
            ${calendarGrid(habit)}
            <div class="mt-6 grid grid-cols-4 gap-2">
              ${cell('Streak', s.current)}
              ${cell('Best', s.longest)}
              ${cell('Total', s.total)}
              ${cell('30-day', s.rate30 + '%')}
            </div>
            <div class="mt-5">${githubGraph(habit)}</div>
            <div class="mt-5 flex justify-end border-t border-slate-100 pt-4 dark:border-slate-800">
              <button data-delete="${habit.id}" class="rounded-lg px-3 py-1.5 text-xs font-medium text-rose-500 transition hover:bg-rose-50 dark:hover:bg-rose-950/40">Delete habit</button>
            </div>
          </div>`;
      }

      function render() {
        const has = habits.length > 0;
        document.getElementById('empty-state').classList.toggle('hidden', has);
        weekHead.classList.toggle('hidden', !has);
        weekHeader();
        list.innerHTML = habits.map((h) => {
          const s = stats(h);
          const isOpen = expanded.has(h.id);
          const color = COLORS[h.color] || COLORS.emerald;
          // Expanded detail view drops the week strip (the month calendar below
          // covers those days); the strip stays only on the collapsed cards.
          const nameBtn = `
            <button data-toggle="${h.id}" class="flex min-w-0 items-center gap-2 py-1.5 pr-2 text-left">
              <span class="shrink-0 text-base">${h.emoji}</span>
              <span class="truncate font-medium">${escapeHtml(h.name)}</span>
              ${s.current > 0 ? `<span class="inline-flex shrink-0 items-center gap-0.5 rounded-full px-1.5 py-0.5 text-[11px] font-semibold tabular-nums" style="color:${color};background:${color}14" title="${s.current}-day streak">${FLAME}${s.current}</span>` : ''}
              <svg class="ml-auto h-4 w-4 shrink-0 text-slate-300 transition ${isOpen ? 'rotate-180' : ''} dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/></svg>
            </button>`;
          return `
          <article class="rounded-2xl bg-white px-4 py-2.5 shadow-sm ring-1 ring-black/5 transition dark:bg-slate-900 dark:ring-white/10">
            ${isOpen
              ? nameBtn + overviewPanel(h)
              : `<div class="${GRID}"><div class="col-span-7 cursor-pointer sm:col-span-1" data-toggle="${h.id}">${nameBtn}</div>${weekCells(h)}</div>`}
          </article>`;
        }).join('');
        renderTodayCard();
      }

      function renderTodayCard() {
        const todayDow = dow(TODAY);
        const due = habits.filter((h) => schedOf(h).has(todayDow));
        const total = due.length;
        let done = 0;
        for (const h of due) if (h.days.includes(TODAY)) done++;
        const pct = total ? Math.round((done / total) * 100) : 0;
        document.getElementById('today-count').textContent = `${done} / ${total}`;
        document.getElementById('today-pct').textContent = pct + '%';
        const circ = 2 * Math.PI * 15.5;
        document.getElementById('today-progress').style.strokeDashoffset = String(circ * (1 - pct / 100));
      }

      // ---- interactions ------------------------------------------------------
      list.addEventListener('click', async (e) => {
        const dayBtn = e.target.closest('.day');
        if (dayBtn) {
          const id = Number(dayBtn.dataset.habit);
          const day = dayBtn.dataset.day;
          const habit = habits.find((h) => h.id === id);
          // optimistic toggle
          const has = habit.days.includes(day);
          habit.days = has ? habit.days.filter((d) => d !== day) : [...habit.days, day];
          render();
          try {
            await fetch('/api/checkins', {
              method: 'POST', headers: authHeaders({ 'Content-Type': 'application/json' }),
              body: JSON.stringify({ habitId: id, day }),
            });
          } catch { /* keep optimistic state */ }
          return;
        }
        const toggle = e.target.closest('[data-toggle]');
        if (toggle) {
          const id = Number(toggle.dataset.toggle);
          if (expanded.has(id)) expanded.delete(id);
          else expanded.add(id);
          render();
          return;
        }
        const calPrev = e.target.closest('[data-cal-prev]');
        if (calPrev) {
          const id = Number(calPrev.dataset.calPrev);
          const v = getCalView(id);
          let m = v.m - 1, y = v.y;
          if (m < 0) { m = 11; y--; }        // roll back across the year
          calView.set(id, { y, m });
          render();
          return;
        }
        const calNext = e.target.closest('[data-cal-next]');
        if (calNext) {
          const id = Number(calNext.dataset.calNext);
          const v = getCalView(id);
          let m = v.m + 1, y = v.y;
          if (m > 11) { m = 0; y++; }         // roll forward across the year
          const t = new Date(TODAY + 'T00:00:00');
          if (y > t.getFullYear() || (y === t.getFullYear() && m > t.getMonth())) return; // never past current month
          calView.set(id, { y, m });
          render();
          return;
        }
        const del = e.target.closest('[data-delete]');
        if (del) {
          const id = Number(del.dataset.delete);
          const habit = habits.find((h) => h.id === id);
          askConfirm(`This permanently deletes “${habit ? habit.name : 'this habit'}” and all its check-ins. This can't be undone.`, () => doDelete(id));
          return;
        }
      });

      async function doDelete(id) {
        habits = habits.filter((h) => h.id !== id);
        expanded.delete(id);
        render();
        await fetch('/api/habits/' + id, { method: 'DELETE', headers: authHeaders() });
      }

      // ---- reusable confirmation modal --------------------------------------
      const confirmModal = document.getElementById('confirm-modal');
      let onConfirmYes = null;
      function showConfirm() { confirmModal.classList.remove('hidden'); confirmModal.classList.add('flex'); }
      function hideConfirm() { confirmModal.classList.add('hidden'); confirmModal.classList.remove('flex'); onConfirmYes = null; }
      function askConfirm(text, fn) { document.getElementById('confirm-text').textContent = text; onConfirmYes = fn; showConfirm(); }
      document.getElementById('confirm-cancel').addEventListener('click', hideConfirm);
      confirmModal.addEventListener('click', (e) => { if (e.target === confirmModal) hideConfirm(); });
      document.getElementById('confirm-delete').addEventListener('click', async () => {
        const fn = onConfirmYes;
        hideConfirm();
        if (fn) await fn();
      });

      // ---- add habit ---------------------------------------------------------
      let selectedColor = 'emerald';
      const picker = document.getElementById('color-picker');
      picker.innerHTML = Object.entries(COLORS).map(([name, hex]) => `
        <button type="button" data-color="${name}" aria-label="${name}"
          class="h-7 w-7 rounded-full border-2 transition ${name === selectedColor ? 'scale-110 border-slate-400 dark:border-white' : 'border-transparent'}"
          style="background:${hex}"></button>`).join('');
      picker.addEventListener('click', (e) => {
        const b = e.target.closest('[data-color]');
        if (!b) return;
        selectedColor = b.dataset.color;
        [...picker.children].forEach((c) =>
          c.className = c.className.replace(/scale-110 border-slate-400 dark:border-white|border-transparent/g,
            c.dataset.color === selectedColor ? 'scale-110 border-slate-400 dark:border-white' : 'border-transparent'));
      });

      // quick emoji suggestions on focus
      const emojiInput = document.getElementById('habit-emoji');
      emojiInput.addEventListener('focus', () => emojiInput.select());

      // ---- frequency selector ------------------------------------------------
      let freqMode = 'daily';                      // 'daily' | 'weekdays' | 'custom'
      let customDays = new Set([1, 2, 3, 4, 5]);   // JS weekday numbers
      const DAY_CHIPS = [[1, 'M'], [2, 'T'], [3, 'W'], [4, 'T'], [5, 'F'], [6, 'S'], [0, 'S']];
      const seg = document.getElementById('freq-seg');
      const daysBox = document.getElementById('freq-days');

      function currentSchedule() {
        if (freqMode === 'daily') return [0, 1, 2, 3, 4, 5, 6];
        if (freqMode === 'weekdays') return [1, 2, 3, 4, 5];
        return [...customDays];
      }
      function renderFreq() {
        const opts = [['daily', 'Every day'], ['weekdays', 'Weekdays'], ['custom', 'Custom']];
        seg.innerHTML = opts.map(([v, l]) => `
          <button type="button" data-freq="${v}"
            class="rounded-lg px-3 py-1.5 text-xs font-semibold transition ${freqMode === v
              ? 'bg-emerald-500 text-white shadow-sm'
              : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'}">${l}</button>`).join('');
        daysBox.classList.toggle('hidden', freqMode !== 'custom');
        daysBox.classList.toggle('flex', freqMode === 'custom');
        if (freqMode === 'custom') {
          daysBox.innerHTML = DAY_CHIPS.map(([n, l]) => `
            <button type="button" data-day-toggle="${n}"
              class="h-8 w-8 rounded-full text-xs font-semibold transition ${customDays.has(n)
                ? 'bg-emerald-500 text-white'
                : 'bg-slate-100 text-slate-500 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700'}">${l}</button>`).join('');
        }
      }
      seg.addEventListener('click', (e) => {
        const b = e.target.closest('[data-freq]');
        if (!b) return;
        freqMode = b.dataset.freq;
        renderFreq();
      });
      daysBox.addEventListener('click', (e) => {
        const b = e.target.closest('[data-day-toggle]');
        if (!b) return;
        const n = Number(b.dataset.dayToggle);
        customDays.has(n) ? customDays.delete(n) : customDays.add(n);
        if (customDays.size === 0) customDays.add(n); // keep at least one
        renderFreq();
      });
      renderFreq();

      document.getElementById('habit-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = document.getElementById('habit-name').value.trim();
        if (!name) return;
        const emoji = emojiInput.value.trim() || '✅';
        const body = { name, emoji, color: selectedColor, schedule: currentSchedule() };
        const res = await fetch('/api/habits', {
          method: 'POST', headers: authHeaders({ 'Content-Type': 'application/json' }),
          body: JSON.stringify(body),
        });
        if (res.ok) {
          const habit = await res.json();
          habits.push(habit);
          document.getElementById('habit-name').value = '';
          document.getElementById('habit-form').classList.add('hidden');
          render();
        }
      });

      // toggle the add form from the header + button
      document.getElementById('add-btn').addEventListener('click', () => {
        const form = document.getElementById('habit-form');
        const hidden = form.classList.toggle('hidden');
        if (!hidden) document.getElementById('habit-name').focus();
      });

      // ---- theme toggle ------------------------------------------------------
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      });

      // ---- PWA install (service worker + in-app install button) -------------
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
      const installBtn = document.getElementById('install-btn');
      let deferredPrompt = null;
      // Chromium fires this when the app is installable; iOS Safari never does
      // (there it's Share → Add to Home Screen), so the button stays hidden.
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        installBtn.classList.remove('hidden');
        installBtn.classList.add('flex');
      });
      installBtn.addEventListener('click', async () => {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        await deferredPrompt.userChoice;
        deferredPrompt = null;
        installBtn.classList.add('hidden');
        installBtn.classList.remove('flex');
      });
      window.addEventListener('appinstalled', () => {
        installBtn.classList.add('hidden');
        installBtn.classList.remove('flex');
      });

      // ---- profile gate + data loading --------------------------------------
      const gate = document.getElementById('gate');
      const loginForm = document.getElementById('login-form');
      const loginName = document.getElementById('login-profile-name');
      const loginPass = document.getElementById('login-passcode');
      const loginError = document.getElementById('login-error');
      const pickerView = document.getElementById('picker-view');
      const profileList = document.getElementById('profile-list');
      const createForm = document.getElementById('create-form');
      const createName = document.getElementById('create-name');
      const createPass = document.getElementById('create-passcode');
      const createError = document.getElementById('create-error');
      const loadError = document.getElementById('load-error');

      let profiles = [];

      function showGate() { gate.classList.remove('hidden'); gate.classList.add('flex'); }
      function hideGate() { gate.classList.add('hidden'); gate.classList.remove('flex'); }
      const manageView = document.getElementById('manage-view');
      function showView(v) {
        loginForm.classList.toggle('hidden', v !== 'login');
        pickerView.classList.toggle('hidden', v !== 'picker');
        createForm.classList.toggle('hidden', v !== 'create');
        manageView.classList.toggle('hidden', v !== 'manage');
      }

      async function loadProfiles() {
        try { profiles = await (await fetch('/api/profiles', { cache: 'no-store' })).json(); }
        catch { profiles = []; }
      }

      // Decide which gate view to show based on what profiles exist / is selected.
      function openGate() {
        showGate();
        if (!profiles.length) { showView('create'); createName.focus(); return; }
        if (!profile) profile = profiles[0]; // default to the first (owner)
        loginName.textContent = profile.name;
        loginError.classList.add('hidden');
        loginPass.value = '';
        showView('login');
        loginPass.focus();
      }

      const TRASH = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/></svg>';
      async function renderPicker() {
        await loadProfiles(); // refresh in case a friend added one on another device
        profileList.innerHTML = profiles.map((p) => {
          const current = profile && p.id === profile.id;
          const deletable = token && profile && (current || profile.admin);
          return `<div class="flex items-center gap-2">
              <button type="button" data-pick="${p.id}" class="h-11 flex-1 rounded-xl border border-slate-200 bg-white text-sm font-medium transition hover:border-emerald-400 dark:border-slate-700 dark:bg-slate-900 ${current ? 'ring-1 ring-emerald-400' : ''}">${escapeHtml(p.name)}</button>
              ${deletable ? `<button type="button" data-del-profile="${p.id}" data-del-name="${escapeHtml(p.name)}" aria-label="Delete ${escapeHtml(p.name)}" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-rose-500 transition hover:bg-rose-50 dark:hover:bg-rose-950/40">${TRASH}</button>` : ''}
            </div>`;
        }).join('');
        document.getElementById('manage-btn').classList.toggle('hidden', !token);
        document.getElementById('picker-cancel').classList.toggle('hidden', !token);
        showView('picker');
      }

      // Returns 'ok' | 'unauthorized' | 'error'
      async function fetchHabits() {
        try {
          const res = await fetch('/api/habits', { headers: authHeaders(), cache: 'no-store' });
          if (res.status === 401) return 'unauthorized';
          if (!res.ok) return 'error';
          habits = await res.json();
          return 'ok';
        } catch { return 'error'; }
      }

      function enterApp() {
        hideGate();
        loadError.classList.add('hidden');
        // show the active profile in the header
        if (profile) {
          document.getElementById('profile-chip-name').textContent = profile.name;
          document.getElementById('profile-chip').classList.remove('hidden');
          document.getElementById('profile-chip').classList.add('flex');
        }
        render();
        initRealtime();
      }

      async function refresh() {
        if (!token) return;
        const r = await fetchHabits();
        if (r === 'ok') { render(); loadError.classList.add('hidden'); }
        else if (r === 'unauthorized') { signOut(); }
      }
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') refresh();
      });
      window.addEventListener('pageshow', (e) => { if (e.persisted) refresh(); });

      function signOut() {
        token = ''; localStorage.removeItem(TK);
        openGate();
      }

      // ---- realtime: apply another device's change surgically ---------------
      function applyRemote(p) {
        if (!p || !p.type) return;
        if (p.type === 'checkin') {
          const h = habits.find((x) => x.id === p.habitId);
          if (!h) return;
          const has = h.days.includes(p.day);
          if (p.checked && !has) h.days = [...h.days, p.day];
          else if (!p.checked && has) h.days = h.days.filter((d) => d !== p.day);
          else return;
        } else if (p.type === 'add') {
          if (p.habit && !habits.some((x) => x.id === p.habit.id)) habits.push(p.habit);
          else return;
        } else if (p.type === 'delete') {
          if (!habits.some((x) => x.id === p.id)) return;
          habits = habits.filter((x) => x.id !== p.id);
          expanded.delete(p.id); calView.delete(p.id);
        } else if (p.type === 'rename') {
          const h = habits.find((x) => x.id === p.id);
          if (!h || h.name === p.name) return;
          h.name = p.name;
        } else return;
        render();
      }

      let realtimeStarted = false;
      async function initRealtime() {
        if (realtimeStarted || !profile) return;
        realtimeStarted = true;
        try {
          const res = await fetch('/api/rt-config', { cache: 'no-store' });
          if (!res.ok) return;
          const cfg = await res.json();
          if (!cfg.enabled) return;
          const pusher = await connectRealtime({ key: cfg.key, cluster: cfg.cluster, channel: `habitrack-${profile.id}`, onEvent: applyRemote });
          const setId = () => { socketId = pusher.connection.socket_id; };
          pusher.connection.bind('connected', setId);
          if (pusher.connection.socket_id) setId();
        } catch { /* best-effort */ }
      }

      // ---- gate interactions ------------------------------------------------
      document.getElementById('switch-profile').addEventListener('click', renderPicker);
      document.getElementById('profile-chip').addEventListener('click', () => { showGate(); renderPicker(); });
      document.getElementById('picker-cancel').addEventListener('click', () => { if (token) hideGate(); });
      document.getElementById('new-profile-btn').addEventListener('click', () => {
        createName.value = ''; createPass.value = ''; createError.classList.add('hidden');
        showView('create'); createName.focus();
      });
      document.getElementById('create-back').addEventListener('click', () => {
        profiles.length ? openGate() : renderPicker();
      });
      profileList.addEventListener('click', (e) => {
        const trash = e.target.closest('[data-del-profile]');
        if (trash) {
          const id = Number(trash.dataset.delProfile);
          const name = trash.dataset.delName;
          askConfirm(`Delete profile “${name}” and all its habits? This can't be undone.`, () => deleteProfileById(id));
          return;
        }
        const b = e.target.closest('[data-pick]');
        if (!b) return;
        profile = profiles.find((p) => p.id === Number(b.dataset.pick));
        openGate();
      });

      // Delete a profile (self → sign out & reload; someone else as admin → refresh list).
      async function deleteProfileById(id) {
        try {
          const res = await fetch('/api/profiles/' + id, { method: 'DELETE', headers: authHeaders() });
          if (!res.ok) { const d = await res.json().catch(() => ({})); alert(d.error || 'Could not delete profile.'); return; }
          if (profile && id === profile.id) {
            token = ''; profile = null;
            localStorage.removeItem(TK); localStorage.removeItem(PID);
            location.reload();
          } else {
            renderPicker();
          }
        } catch { alert('Could not delete profile.'); }
      }

      // ---- manage profile (rename / change passcode / delete self) ----------
      const manageMsg = document.getElementById('manage-msg');
      function showManageMsg(text, ok) {
        manageMsg.textContent = text;
        manageMsg.className = `mt-2 text-xs font-medium ${ok ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-500'}`;
        manageMsg.classList.remove('hidden');
      }
      document.getElementById('manage-btn').addEventListener('click', () => {
        document.getElementById('manage-name').textContent = profile.name;
        document.getElementById('manage-rename').value = profile.name;
        document.getElementById('manage-cur-pass').value = '';
        document.getElementById('manage-new-pass').value = '';
        manageMsg.classList.add('hidden');
        showView('manage');
      });
      document.getElementById('manage-back').addEventListener('click', renderPicker);
      document.getElementById('manage-rename-save').addEventListener('click', async () => {
        const name = document.getElementById('manage-rename').value.trim();
        if (!name) return;
        try {
          const res = await fetch('/api/profiles/' + profile.id, {
            method: 'PATCH', headers: authHeaders({ 'Content-Type': 'application/json' }),
            body: JSON.stringify({ name }),
          });
          if (!res.ok) { const d = await res.json().catch(() => ({})); showManageMsg(d.error || 'Rename failed.', false); return; }
          profile.name = name;
          localStorage.setItem(PID, JSON.stringify(profile));
          document.getElementById('profile-chip-name').textContent = name;
          document.getElementById('manage-name').textContent = name;
          showManageMsg('Name updated.', true);
        } catch { showManageMsg('Rename failed.', false); }
      });
      document.getElementById('manage-pass-save').addEventListener('click', async () => {
        const currentPasscode = document.getElementById('manage-cur-pass').value;
        const newPasscode = document.getElementById('manage-new-pass').value;
        if (newPasscode.length < 4) { showManageMsg('New passcode must be at least 4 characters.', false); return; }
        try {
          const res = await fetch('/api/profiles/' + profile.id, {
            method: 'PATCH', headers: authHeaders({ 'Content-Type': 'application/json' }),
            body: JSON.stringify({ currentPasscode, newPasscode }),
          });
          if (!res.ok) { const d = await res.json().catch(() => ({})); showManageMsg(d.error || 'Could not change passcode.', false); return; }
          document.getElementById('manage-cur-pass').value = '';
          document.getElementById('manage-new-pass').value = '';
          showManageMsg('Passcode changed.', true);
        } catch { showManageMsg('Could not change passcode.', false); }
      });
      document.getElementById('manage-delete').addEventListener('click', () => {
        askConfirm(`Delete your profile “${profile.name}” and all its habits? This can't be undone.`, () => deleteProfileById(profile.id));
      });

      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const passcode = loginPass.value;
        if (!passcode) return;
        loginError.classList.add('hidden');
        try {
          const res = await fetch('/api/login', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ profileId: profile.id, passcode }),
          });
          if (res.status === 401) { loginError.classList.remove('hidden'); loginPass.select(); return; }
          if (!res.ok) throw new Error();
          const data = await res.json();
          token = data.token; profile = { id: data.id, name: data.name, admin: !!data.admin };
          localStorage.setItem(TK, token);
          localStorage.setItem(PID, JSON.stringify(profile));
          if (realtimeStarted) { location.reload(); return; } // switching — rebind cleanly
          const r = await fetchHabits();
          if (r === 'ok') enterApp();
        } catch {
          loginError.textContent = 'Something went wrong — try again.';
          loginError.classList.remove('hidden');
        }
      });

      createForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = createName.value.trim();
        const passcode = createPass.value;
        createError.classList.add('hidden');
        if (!name) { createError.textContent = 'Name is required.'; createError.classList.remove('hidden'); return; }
        if (passcode.length < 4) { createError.textContent = 'Passcode must be at least 4 characters.'; createError.classList.remove('hidden'); return; }
        try {
          const res = await fetch('/api/profiles', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, passcode }),
          });
          if (!res.ok) { const d = await res.json().catch(() => ({})); throw new Error(d.error || ''); }
          const data = await res.json();
          token = data.token; profile = { id: data.id, name: data.name, admin: !!data.admin };
          localStorage.setItem(TK, token);
          localStorage.setItem(PID, JSON.stringify(profile));
          if (realtimeStarted) { location.reload(); return; } // switching — rebind cleanly
          const r = await fetchHabits();
          if (r === 'ok') enterApp();
        } catch (err) {
          createError.textContent = err.message || 'Could not create profile.';
          createError.classList.remove('hidden');
        }
      });

      async function boot() {
        await loadProfiles();
        if (token && profile) {
          const r = await fetchHabits();
          if (r === 'ok') { enterApp(); return; }
          if (r === 'unauthorized') { token = ''; localStorage.removeItem(TK); }
          else { hideGate(); loadError.classList.remove('hidden'); return; }
        }
        openGate();
      }

      boot();
    </script>
  </body>
</html>
