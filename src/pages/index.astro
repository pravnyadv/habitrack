---
import HabitApp from '../components/HabitApp.astro';
import { getSql, listHabits, getProfile } from '../lib/db.js';

// Middleware already verified the session cookie for this route and handed us the
// profile id via locals, so we can fetch the signed-in profile's habits
// server-side and ship them in the HTML. (Share-preview mode is a client concept,
// so that rarer path still fetches; see boot() in HabitApp.)
// We also SSR the profile identity: iOS copies the session COOKIE into an
// installed PWA but NOT localStorage, so the client's `profile` can be empty even
// with a valid cookie — the client hydrates from this instead of bouncing away.
// Both queries go out in parallel — each Neon call is its own HTTP round trip, so
// awaiting them in sequence would double this page's time-to-first-byte.
const env = Astro.locals.runtime?.env;
const pid = Astro.locals.profileId;
let initialHabits = [];
let initialProfile = null;
try {
  if (pid) {
    const sql = getSql(env);
    const [habits, p] = await Promise.all([listHabits(sql, pid), getProfile(sql, pid)]);
    initialHabits = habits;
    if (p) initialProfile = { id: p.id, name: p.name, admin: !!p.is_admin };
  }
} catch { initialHabits = []; }
---

<HabitApp mode="app" initialHabits={initialHabits} initialProfile={initialProfile} />
