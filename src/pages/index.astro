---
import '../styles/global.css';
import AppHeader from '../components/AppHeader.astro';
import { getSql, listHabits } from '../lib/db.js';
import { verifyToken, TOKEN_COOKIE } from '../lib/auth.js';

// Middleware already guaranteed a valid session cookie for this route, so we can
// fetch the signed-in profile's habits server-side and ship them in the HTML —
// the app renders instantly with no empty→filled flash. (View-mode is a client
// concept, so that rarer path still fetches; see boot().)
const env = Astro.locals.runtime?.env;
const token = Astro.cookies.get(TOKEN_COOKIE)?.value;
let initialHabits = [];
try {
  const pid = token ? await verifyToken(token, env) : null;
  if (pid) initialHabits = await listHabits(getSql(env), pid);
} catch { initialHabits = []; }
const initialJson = JSON.stringify(initialHabits).replace(/</g, '\\u003c');
---

<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Habitrack — build better habits</title>
    <meta name="description" content="A simple, beautiful habit tracker." />
    <meta name="robots" content="noindex, nofollow" />

    <!-- PWA / iOS home-screen -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Habitrack" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Auth is gated server-side by middleware (redirects to /profile before any
      // HTML is sent), so no client-side guard is needed here.
      // Apply theme before paint to avoid flash
      const t = localStorage.getItem('theme');
      if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="h-full bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 font-sans antialiased">

    <!-- Delete confirmation -->
    <div id="confirm-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 px-6 backdrop-blur-sm">
      <div class="w-full max-w-xs rounded-2xl bg-white p-5 shadow-xl dark:bg-slate-900">
        <p id="confirm-title" class="text-base font-semibold">Are you sure?</p>
        <p id="confirm-text" class="mt-1.5 text-sm text-slate-500 dark:text-slate-400"></p>
        <div class="mt-5 flex gap-2">
          <button id="confirm-cancel" class="h-10 flex-1 rounded-xl bg-slate-100 text-sm font-semibold text-slate-700 transition hover:bg-slate-200 active:scale-95 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Cancel</button>
          <button id="confirm-ok" class="h-10 flex-1 rounded-xl bg-rose-500 text-sm font-semibold text-white transition hover:bg-rose-600 active:scale-95">Delete</button>
        </div>
      </div>
    </div>

    <!-- iOS-only install hint (Safari has no auto-install / address-bar icon).
         Fixed bottom banner, dismissible, shown once — never on desktop/Chrome. -->
    <div id="ios-install" class="fixed inset-x-0 bottom-0 z-40 hidden translate-y-4 px-3 pb-[calc(env(safe-area-inset-bottom)+10px)] opacity-0 transition-all duration-300">
      <div class="mx-auto flex max-w-md items-center gap-3 rounded-2xl border border-slate-200 bg-white/95 p-3 shadow-lg backdrop-blur dark:border-slate-700 dark:bg-slate-900/95">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 8.25H7.5a2.25 2.25 0 0 0-2.25 2.25v9a2.25 2.25 0 0 0 2.25 2.25h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25H15m0-3-3-3m0 0-3 3m3-3V15" /></svg>
        </span>
        <p class="min-w-0 flex-1 text-xs leading-snug text-slate-600 dark:text-slate-300">
          Install Habitrack — tap <span class="font-semibold text-slate-900 dark:text-white">Share</span>, then <span class="font-semibold text-slate-900 dark:text-white">Add to Home Screen</span>.
        </p>
        <button id="ios-install-close" aria-label="Dismiss" class="shrink-0 rounded-lg p-1.5 text-slate-400 transition hover:text-slate-600 dark:hover:text-slate-200">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
        </button>
      </div>
    </div>

    <div class="mx-auto max-w-3xl px-4 pb-24 pt-8 sm:pt-12">

      <!-- Header (shared with /profile via the AppHeader component) -->
      <AppHeader showAdd showOverview />

      <!-- Read-only banner (shown when viewing a profile shared with you) -->
      <div id="view-banner" class="mb-6 hidden items-center justify-between gap-2 rounded-xl border border-amber-200 bg-amber-50 px-4 py-2.5 text-sm text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-300">
        <span class="flex min-w-0 items-center gap-2">
          <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
          <span class="truncate">Viewing <span id="view-banner-name" class="font-semibold"></span> · read-only</span>
        </span>
        <button id="view-exit" class="shrink-0 rounded-lg px-2.5 py-1 text-xs font-semibold text-amber-800 transition hover:bg-amber-100 dark:text-amber-200 dark:hover:bg-amber-900/50">Exit</button>
      </div>

      <div id="load-error" class="mb-6 hidden rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700 dark:border-rose-900 dark:bg-rose-950/50 dark:text-rose-300">
        Couldn't reach the server. Check your connection and reload.
      </div>

      <!-- Today progress -->
      <section id="today-card" class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Today's progress</p>
            <p id="today-count" class="mt-0.5 text-2xl font-bold tabular-nums">0 / 0</p>
          </div>
          <div id="today-ring" class="relative h-16 w-16">
            <svg class="h-16 w-16 -rotate-90" viewBox="0 0 36 36">
              <circle cx="18" cy="18" r="15.5" fill="none" class="stroke-slate-100 dark:stroke-slate-800" stroke-width="4" />
              <circle id="today-progress" cx="18" cy="18" r="15.5" fill="none" class="stroke-emerald-500" stroke-width="4" stroke-linecap="round" stroke-dasharray="97.4" stroke-dashoffset="97.4" style="transition: stroke-dashoffset .5s ease" />
            </svg>
            <span id="today-pct" class="absolute inset-0 flex items-center justify-center text-sm font-semibold tabular-nums">0%</span>
          </div>
        </div>
      </section>

      <!-- Add habit (toggled by the + in the header) -->
      <form id="habit-form" class="mb-6 hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-center gap-2">
          <div class="relative shrink-0">
            <input id="habit-emoji" name="emoji" maxlength="2" value="✅" aria-label="Emoji, tap to change" title="Tap to change the emoji" readonly
              class="h-11 w-12 cursor-pointer rounded-xl border border-slate-200 bg-slate-50 text-center text-xl outline-none focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-800" />
            <span class="pointer-events-none absolute -bottom-1 -right-1 flex h-[18px] w-[18px] items-center justify-center rounded-full bg-emerald-500 text-white shadow ring-2 ring-white dark:ring-slate-900">
              <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24"><path d="M21.731 2.269a2.625 2.625 0 0 0-3.712 0l-1.157 1.157 3.712 3.712 1.157-1.157a2.625 2.625 0 0 0 0-3.712ZM19.513 8.199l-3.712-3.712-8.4 8.4a5.25 5.25 0 0 0-1.32 2.214l-.8 2.685a.75.75 0 0 0 .933.933l2.685-.8a5.25 5.25 0 0 0 2.214-1.32l8.4-8.4Z" /></svg>
            </span>
            <div id="emoji-pop" class="no-scrollbar absolute left-0 top-full z-20 mt-1.5 hidden max-h-64 w-64 overflow-y-auto rounded-xl border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900">
              <div id="emoji-grid" class="grid grid-cols-6 gap-1"></div>
            </div>
          </div>
          <input id="habit-name" name="name" placeholder="e.g. Morning run" autocomplete="off" required
            class="h-11 flex-1 rounded-xl border border-slate-200 bg-slate-50 px-3.5 text-sm outline-none focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-800" />
          <button type="submit" id="habit-submit"
            class="h-11 shrink-0 rounded-xl bg-emerald-500 px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600 active:scale-95">Add</button>
        </div>
        <div id="color-picker" class="mt-3 flex flex-wrap justify-center gap-2"></div>
        <div class="mt-4">
          <p class="mb-1.5 text-xs font-medium text-slate-500 dark:text-slate-400">How often?</p>
          <div class="flex items-center justify-between gap-2">
            <div id="freq-seg" class="flex gap-1.5"></div>
            <button type="button" id="habit-close" aria-label="Close" title="Close"
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800 dark:hover:text-slate-200">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
            </button>
          </div>
          <div id="freq-days" class="mt-2 hidden flex-wrap gap-1.5"></div>
        </div>
      </form>

      <!-- Weekday header -->
      <div id="week-header" class="mb-2 px-4"></div>

      <!-- Habit list -->
      <main id="habit-list" class="space-y-2"></main>

      <div id="empty-state" class="hidden py-10 text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-50 text-3xl dark:bg-emerald-950/40">🌱</div>
        <p id="empty-title" class="text-base font-semibold">Start your first habit</p>
        <p id="empty-sub" class="mx-auto mt-1 max-w-xs text-sm text-slate-400 dark:text-slate-500">Track something you want to do regularly — check it off with one tap a day.</p>
        <button id="empty-add-btn"
          class="mx-auto mt-5 flex w-full max-w-xs items-center justify-center gap-1.5 rounded-xl border border-dashed border-emerald-300 py-3 text-sm font-semibold text-emerald-600 transition hover:border-emerald-400 hover:bg-emerald-50 dark:border-emerald-800 dark:text-emerald-400 dark:hover:bg-emerald-950/40">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
          Add a habit
        </button>
      </div>
    </div>

    <script id="initial-habits" type="application/json" is:inline set:html={initialJson}></script>

    <script>
      import { COLORS, COLORS_DARK, MONTHS, WD, TODAY, BACKFILL_DAYS, iso, pad2, addDays, dow, schedOf, stats, windowStart, heatmapBlock, githubGraph, escapeHtml, connectRealtime, apiFetch } from '../lib/compute.js';

      // Earliest day a check-in can still be marked (today − (BACKFILL_DAYS−1)).
      const BACKFILL_START = addDays(TODAY, -(BACKFILL_DAYS - 1));

      // Server-rendered initial habits (own profile) — render instantly, no flash.
      let initialHabits = [];
      try { initialHabits = JSON.parse(document.getElementById('initial-habits')?.textContent || '[]'); } catch {}

      // ---- constants ---------------------------------------------------------
      const EMOJIS = [
        // movement & fitness
        '✅','🏃','🚶','🚴','🏊','🏋️','🧘','💪','🤸','🧗','⚽','🏀',
        // food, drink & body
        '💧','🥗','🥦','🍎','🥤','☕','😴','🛌','💊','🦷','🚿','⚖️',
        // mind, learning & work
        '📖','📚','✍️','📝','🧠','🎯','💻','🗣️','🎓','🧩','🌐','📅',
        // creativity, spirit & calm
        '🎨','🎸','🎹','🎧','🙏','🌙','☀️','🌱','🧴','🕯️','📷','🍳',
        // home, money, quitting & pets
        '🧹','🧺','💰','⏰','📵','🚭','🍺','🎰','🐕','🌿','👨‍👩‍👧','📞',
      ];

      let habits = [];
      const expanded = new Set();

      // ---- auth: signed token + selected profile (both in localStorage) ------
      const TK = 'habitrack_token';
      const PID = 'habitrack_profile';
      const VIEW = 'habitrack_viewing';
      let token = localStorage.getItem(TK) || '';
      let profile = null; // { id, name }
      try { profile = JSON.parse(localStorage.getItem(PID) || 'null'); } catch {}
      // When set ({id,name}), the app shows this shared profile read-only instead
      // of our own. Persisted so it survives the reload used to rebind realtime.
      let viewing = null;
      try { viewing = JSON.parse(localStorage.getItem(VIEW) || 'null'); } catch {}
      const dataId = () => (viewing ? viewing.id : (profile && profile.id));
      let socketId = null; // our realtime socket, sent so the server excludes us
      // Bound API client: reads the live token + socketId on every call.
      const api = (path, opts = {}) => apiFetch(path, { token, socketId, ...opts });

      // ---- rendering ---------------------------------------------------------
      const list = document.getElementById('habit-list');
      const weekHead = document.getElementById('week-header');

      // Mobile: 7 equal columns — the name sits on its own full-width row above
      // the checks. Desktop (sm+): name column + 7 fixed day columns on one row.
      const GRID = 'grid grid-cols-7 gap-y-1 sm:grid-cols-[minmax(0,1fr)_repeat(7,2.25rem)] sm:gap-y-0 items-center';
      const last7 = () => Array.from({ length: 7 }, (_, i) => addDays(TODAY, i - 6));

      const CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px]"><path d="M4.5 12.75l6 6 9-13.5"/></svg>';
      const CROSS = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M6 18L18 6M6 6l12 12"/></svg>';
      const FLAME = '<svg viewBox="0 0 24 24" fill="currentColor" class="h-3 w-3"><path d="M12.963 2.286a.75.75 0 0 0-1.071-.136 9.742 9.742 0 0 0-3.539 6.177A7.547 7.547 0 0 1 6.648 6.61a.75.75 0 0 0-1.152-.081A9 9 0 1 0 15.68 4.534a7.46 7.46 0 0 1-2.717-2.248Z"/><path d="M15.75 14.25a3.75 3.75 0 1 1-7.313-1.172c.628.465 1.35.81 2.133 1.005a5.99 5.99 0 0 1 1.925-3.547 3.75 3.75 0 0 1 3.255 3.714Z"/></svg>';

      function weekHeader() {
        const cols = last7().map((d) => {
          const dd = new Date(d + 'T00:00:00');
          const isToday = d === TODAY;
          return `<div class="flex flex-col items-center leading-tight ${isToday ? 'text-slate-900 dark:text-white' : 'text-slate-400 dark:text-slate-500'}">
              <span class="text-[11px] font-medium">${dd.toLocaleDateString('en-US', { weekday: 'short' })}</span>
              <span class="text-[11px] ${isToday ? 'font-semibold' : ''}">${dd.getDate()}</span>
            </div>`;
        }).join('');
        // leading empty cell only exists on desktop (name column)
        weekHead.innerHTML = `<div class="${GRID}"><span class="hidden sm:block"></span>${cols}</div>`;
      }

      const REST = '<span class="h-1 w-1 rounded-full bg-slate-200 dark:bg-slate-700"></span>';
      function weekCells(habit) {
        const set = new Set(habit.days);
        const sched = schedOf(habit);
        const color = COLORS[habit.color] || COLORS.emerald;
        return last7().map((d) => {
          const isToday = d === TODAY;
          if (!sched.has(dow(d))) {
            // rest day — not tracked, not clickable
            return `<div class="flex h-9 items-center justify-center opacity-70" title="${d} · rest day">${REST}</div>`;
          }
          const done = set.has(d);
          const editable = !viewing && d >= BACKFILL_START;   // today + the backfill window
          const todayBg = isToday ? 'rounded-lg bg-slate-50/70 dark:bg-slate-800/40' : '';
          // marker: done ✓ (color) · markable ◯ (hollow ring) · missed & locked ✕ (faint)
          const marker = done
            ? `<span style="color:${color}">${CHECK}</span>`
            : editable
              ? `<span class="h-[18px] w-[18px] rounded-full border-2 ${isToday ? '' : 'border-slate-300 dark:border-slate-600'}"${isToday ? ` style="border-color:${color}"` : ''}></span>`
              : `<span class="text-slate-300 dark:text-slate-600">${CROSS}</span>`;
          if (!editable) {
            return `<div class="flex h-9 items-center justify-center ${todayBg}" title="${d}${done ? ' · done' : ''}">${marker}</div>`;
          }
          return `<button data-day="${d}" data-habit="${habit.id}"
              class="day flex h-9 items-center justify-center rounded-lg transition hover:bg-slate-50 active:scale-90 dark:hover:bg-slate-800/60 ${todayBg}"
              title="${d}${done ? ' · done' : ''}">${marker}</button>`;
        }).join('');
      }

      // ---- LEVEL 1: single-month calendar (current month by default) ---------
      const calView = new Map(); // habitId -> {y, m} of the month being viewed
      function getCalView(id) {
        if (!calView.has(id)) {
          const d = new Date(TODAY + 'T00:00:00');
          calView.set(id, { y: d.getFullYear(), m: d.getMonth() });
        }
        return calView.get(id);
      }

      function calendarGrid(habit) {
        const { y, m } = getCalView(habit.id);
        const set = new Set(habit.days);
        const sched = schedOf(habit);
        const color = COLORS[habit.color] || COLORS.emerald;
        const colorDark = COLORS_DARK[habit.color] || COLORS_DARK.emerald;
        const t = new Date(TODAY + 'T00:00:00');
        const atCurrent = (y === t.getFullYear() && m === t.getMonth());
        const monthLabel = new Date(y, m, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

        const firstDow = (new Date(y, m, 1).getDay() + 6) % 7; // Mon=0
        const daysInMonth = new Date(y, m + 1, 0).getDate();

        // habit's active-from date = earlier of created date / first check-in.
        // Nothing before this can be "missed" — the habit didn't exist yet.
        const firstCheckin = habit.days.length ? habit.days.reduce((a, b) => (a < b ? a : b)) : null;
        const created = (habit.created_at || '').slice(0, 10) || null;
        const activeFrom = (firstCheckin && created) ? (firstCheckin < created ? firstCheckin : created) : (firstCheckin || created);

        // Weekday headers: medium/secondary gray structural labels.
        const wdRow = WD.map((w) => `<div class="text-center text-[11px] font-medium text-slate-500 dark:text-slate-400">${w}</div>`).join('');

        // Hybrid streak-tile calendar. Each cell is an aspect-square grid slot;
        // an absolutely-centered inner "tile" carries the fill, the number sits
        // centered on top. Columns touch (gap-x-0) so full-width done tiles form
        // one continuous capsule; corners square on any side that abuts another
        // done day (same-row link or row-wrap), rounded otherwise.
        const R = 12;                        // outer corner radius (px)
        const HGT = '78%';                   // tile height within the square cell
        const tint = `${color}20`;           // ~12% tint of the habit color (missed)
        const CTR = 'absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2';
        // done numbers are 500 (heavier); every other state is 400 — weight is
        // added per-state below, not baked into NUM.
        const NUM = `${CTR} z-10 text-sm tabular-nums`;

        // Cells are inert <div>s when read-only (viewing a share) OR older than the
        // backfill window — history you can see but not rewrite. Within the window
        // (and today) they're tappable buttons.
        const ro = !!viewing;
        const editableDay = (ds) => !ro && ds >= BACKFILL_START && ds <= TODAY;
        const cellOpen = (ds, title) => editableDay(ds)
          ? `<button data-day="${ds}" data-habit="${habit.id}" class="day relative aspect-square transition active:opacity-70" title="${title}">`
          : `<div class="relative aspect-square" title="${title}">`;
        const cellClose = (ds) => editableDay(ds) ? '</button>' : '</div>';

        let cells = '';
        for (let i = 0; i < firstDow; i++) cells += '<div></div>';
        for (let d = 1; d <= daysInMonth; d++) {
          const ds = `${y}-${pad2(m + 1)}-${pad2(d)}`;
          const future = ds > TODAY;
          const beforeActive = activeFrom && ds < activeFrom;
          const scheduled = sched.has(new Date(y, m, d).getDay());
          const done = set.has(ds);
          const isToday = ds === TODAY;

          if (done) {
            // square the side that abuts another done day; full-width when linked
            const leftSq = set.has(addDays(ds, -1));
            const rightSq = set.has(addDays(ds, 1));
            const full = leftSq || rightSq;
            const br = `${leftSq ? 0 : R}px ${rightSq ? 0 : R}px ${rightSq ? 0 : R}px ${leftSq ? 0 : R}px`;
            const fill = `<span class="${CTR}" style="width:${full ? '100%' : '80%'};height:${HGT};background:${color};border-radius:${br}"></span>`;
            cells += `${cellOpen(ds, ds + ' · done')}${fill}<span class="${NUM} font-medium text-white">${d}</span>${cellClose(ds)}`;
          } else if (isToday && scheduled) {
            // today, not done — transparent tile with an inset ring in habit color
            const fill = `<span class="${CTR}" style="width:80%;height:${HGT};border-radius:${R}px;box-shadow:inset 0 0 0 1.5px ${color}"></span>`;
            cells += `${cellOpen(ds, ds)}${fill}<span class="${NUM} font-normal" style="color:${colorDark}">${d}</span>${cellClose(ds)}`;
          } else if (scheduled && !future && !beforeActive) {
            // missed (past, active, scheduled, not done) — light tint, discrete tile
            const fill = `<span class="${CTR}" style="width:80%;height:${HGT};background:${tint};border-radius:10px"></span>`;
            cells += `${cellOpen(ds, ds + ' · missed')}${fill}<span class="${NUM} font-normal" style="color:${colorDark}">${d}</span>${cellClose(ds)}`;
          } else {
            // before-created / future / rest day — no fill, legible-but-subordinate
            // gray. The ONLY state that uses gray (never a global default).
            cells += `<div class="relative flex aspect-square items-center justify-center text-sm font-normal tabular-nums text-slate-500 dark:text-slate-400">${d}</div>`;
          }
        }

        const arrowBtn = (dir, attr) => `<button ${attr} aria-label="${dir === 'prev' ? 'Previous' : 'Next'} month"
            class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="${dir === 'prev' ? 'M15.75 19.5 8.25 12l7.5-7.5' : 'm8.25 4.5 7.5 7.5-7.5 7.5'}"/></svg>
          </button>`;

        const legend = `<div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] text-slate-500 dark:text-slate-400">
            <span class="flex items-center gap-1.5"><span class="inline-block h-3 w-6 rounded-full" style="background:${color}"></span>Streak</span>
            <span class="flex items-center gap-1.5"><span class="inline-block h-3.5 w-3.5 rounded" style="background:${tint}"></span>Missed</span>
            <span class="flex items-center gap-1.5"><span class="inline-block h-3.5 w-3.5 rounded" style="box-shadow:inset 0 0 0 1.5px ${color}"></span>Today</span>
          </div>`;

        // Cap the calendar footprint (~70% of full width) so the tiles are ~30%
        // more compact. Cells shrink uniformly; inner-tile percentages are
        // unchanged, so connected done-tiles stay 100%-of-cell and still touch.
        return `
          <div class="mx-auto max-w-[420px]">
            <div class="mb-3 flex items-center justify-between">
              ${arrowBtn('prev', `data-cal-prev="${habit.id}"`)}
              <span class="text-sm font-semibold">${monthLabel}</span>
              ${atCurrent ? '<span class="h-8 w-8" aria-hidden="true"></span>' : arrowBtn('next', `data-cal-next="${habit.id}"`)}
            </div>
            <div class="grid grid-cols-7 gap-x-0">${wdRow}</div>
            <div class="mt-1 grid grid-cols-7 gap-x-0 gap-y-[5px]">${cells}</div>
            ${legend}
          </div>`;
      }

      // up/down mover; disabled at the list ends (idx computed from live order)
      function reorderBtn(dir, id) {
        const idx = habits.findIndex((h) => h.id === id);
        const disabled = dir === 'up' ? idx <= 0 : idx >= habits.length - 1;
        // full arrows (with stem) read as "move", distinct from the collapse chevron
        const path = dir === 'up' ? 'M12 19.5V4.5m0 0L6.75 9.75M12 4.5l5.25 5.25' : 'M12 4.5v15m0 0 5.25-5.25M12 19.5 6.75 14.25';
        return `<button ${disabled ? 'disabled' : `data-move="${dir}" data-habit-move="${id}"`} aria-label="Move ${dir}"
            class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 disabled:opacity-30 disabled:hover:bg-transparent dark:text-slate-400 dark:hover:bg-slate-800">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="${path}"/></svg>
          </button>`;
      }

      // ---- expanded panel: overview (calendar) + optional stats -------------
      function overviewPanel(habit) {
        const s = stats(habit);
        const cell = (label, val) => `
          <div class="rounded-xl bg-slate-50 px-3 py-2.5 text-center dark:bg-slate-800/50">
            <div class="text-lg font-bold tabular-nums">${val}</div>
            <div class="text-[11px] font-medium text-slate-500 dark:text-slate-400">${label}</div>
          </div>`;

        return `
          <div class="mt-5 border-t border-slate-100 pt-5 dark:border-slate-800">
            ${calendarGrid(habit)}
            <div class="mt-6 grid grid-cols-4 gap-2">
              ${cell('Streak', s.current)}
              ${cell('Best', s.longest)}
              ${cell('Total', s.total)}
              ${cell('30-day', s.rate30 + '%')}
            </div>
            <div class="mt-5">${githubGraph(habit)}</div>
            ${viewing ? '' : `<div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4 dark:border-slate-800">
              <div class="flex items-center gap-1">
                <span class="mr-0.5 text-[11px] font-medium text-slate-400 dark:text-slate-500">Reorder</span>
                ${reorderBtn('up', habit.id)}
                ${reorderBtn('down', habit.id)}
              </div>
              <div class="flex items-center gap-1">
                <button data-edit="${habit.id}" class="rounded-lg px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800">Edit</button>
                <button data-delete="${habit.id}" class="rounded-lg px-3 py-1.5 text-xs font-medium text-rose-500 transition hover:bg-rose-50 dark:hover:bg-rose-950/40">Delete</button>
              </div>
            </div>`}
          </div>`;
      }

      function render() {
        const has = habits.length > 0;
        document.getElementById('empty-state').classList.toggle('hidden', has);
        if (!has) {
          // Viewers can't add — show a neutral message instead of the add button.
          document.getElementById('empty-add-btn').classList.toggle('hidden', !!viewing);
          document.getElementById('empty-title').textContent = viewing ? 'No habits yet' : 'Start your first habit';
          document.getElementById('empty-sub').textContent = viewing
            ? `${viewing.name} hasn’t added any habits yet.`
            : 'Track something you want to do regularly — check it off with one tap a day.';
        }
        weekHead.classList.toggle('hidden', !has);
        weekHeader();
        list.innerHTML = habits.map((h) => {
          const s = stats(h);
          const isOpen = expanded.has(h.id);
          const color = COLORS[h.color] || COLORS.emerald;
          // Expanded detail view drops the week strip (the month calendar below
          // covers those days); the strip stays only on the collapsed cards.
          const nameBtn = `
            <button data-toggle="${h.id}" class="flex w-full min-w-0 items-center gap-2 py-1.5 pr-2 text-left">
              <span class="shrink-0 text-base">${h.emoji}</span>
              <span class="truncate font-medium">${escapeHtml(h.name)}</span>
              ${s.current > 0 ? `<span class="inline-flex shrink-0 items-center gap-0.5 rounded-full px-1.5 py-0.5 text-[11px] font-semibold tabular-nums" style="color:${color};background:${color}14" title="${s.current}-day streak">${FLAME}${s.current}</span>` : ''}
              <svg class="ml-auto h-4 w-4 shrink-0 text-slate-300 transition ${isOpen ? 'rotate-180' : ''} dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/></svg>
            </button>`;
          return `
          <article class="rounded-2xl bg-white px-4 py-2.5 shadow-sm ring-1 ring-black/5 transition dark:bg-slate-900 dark:ring-white/10">
            ${isOpen
              ? nameBtn + overviewPanel(h)
              : `<div class="${GRID}"><div class="col-span-7 cursor-pointer sm:col-span-1" data-toggle="${h.id}">${nameBtn}</div>${weekCells(h)}</div>`}
          </article>`;
        }).join('');
        renderTodayCard();
      }

      function renderTodayCard() {
        const todayDow = dow(TODAY);
        const due = habits.filter((h) => schedOf(h).has(todayDow));
        const total = due.length;
        let done = 0;
        for (const h of due) if (h.days.includes(TODAY)) done++;
        const pct = total ? Math.round((done / total) * 100) : 0;
        document.getElementById('today-count').textContent = `${done} / ${total}`;
        document.getElementById('today-pct').textContent = pct + '%';
        const circ = 2 * Math.PI * 15.5;
        document.getElementById('today-progress').style.strokeDashoffset = String(circ * (1 - pct / 100));
      }

      // ---- interactions ------------------------------------------------------
      list.addEventListener('click', async (e) => {
        const dayBtn = e.target.closest('.day');
        if (dayBtn) {
          if (viewing) return; // read-only: never write to a shared profile
          const id = Number(dayBtn.dataset.habit);
          const day = dayBtn.dataset.day;
          const habit = habits.find((h) => h.id === id);
          // optimistic toggle
          const has = habit.days.includes(day);
          habit.days = has ? habit.days.filter((d) => d !== day) : [...habit.days, day];
          render();
          try {
            await api('/api/checkins', { method: 'POST', body: { habitId: id, day } });
          } catch { /* keep optimistic state */ }
          return;
        }
        const toggle = e.target.closest('[data-toggle]');
        if (toggle) {
          const id = Number(toggle.dataset.toggle);
          if (expanded.has(id)) expanded.delete(id);
          else expanded.add(id);
          render();
          return;
        }
        const calPrev = e.target.closest('[data-cal-prev]');
        if (calPrev) {
          const id = Number(calPrev.dataset.calPrev);
          const v = getCalView(id);
          let m = v.m - 1, y = v.y;
          if (m < 0) { m = 11; y--; }        // roll back across the year
          calView.set(id, { y, m });
          render();
          return;
        }
        const calNext = e.target.closest('[data-cal-next]');
        if (calNext) {
          const id = Number(calNext.dataset.calNext);
          const v = getCalView(id);
          let m = v.m + 1, y = v.y;
          if (m > 11) { m = 0; y++; }         // roll forward across the year
          const t = new Date(TODAY + 'T00:00:00');
          if (y > t.getFullYear() || (y === t.getFullYear() && m > t.getMonth())) return; // never past current month
          calView.set(id, { y, m });
          render();
          return;
        }
        const del = e.target.closest('[data-delete]');
        if (del) {
          const id = Number(del.dataset.delete);
          const habit = habits.find((h) => h.id === id);
          askConfirm('Delete habit?', `This permanently deletes “${habit ? habit.name : 'this habit'}” and all its check-ins. This can't be undone.`, () => doDelete(id));
          return;
        }
        const edit = e.target.closest('[data-edit]');
        if (edit) {
          const habit = habits.find((h) => h.id === Number(edit.dataset.edit));
          if (habit) enterEditMode(habit);
          return;
        }
        const move = e.target.closest('[data-move]');
        if (move) {
          moveHabit(Number(move.dataset.habitMove), move.dataset.move);
          return;
        }
      });

      // ---- reorder -----------------------------------------------------------
      function moveHabit(id, dir) {
        const i = habits.findIndex((h) => h.id === id);
        const j = dir === 'up' ? i - 1 : i + 1;
        if (i < 0 || j < 0 || j >= habits.length) return;
        [habits[i], habits[j]] = [habits[j], habits[i]];
        render();
        api('/api/habits/reorder', { method: 'POST', body: { ids: habits.map((h) => h.id) } });
      }

      async function doDelete(id) {
        habits = habits.filter((h) => h.id !== id);
        expanded.delete(id);
        render();
        await api('/api/habits/' + id, { method: 'DELETE' });
      }

      // ---- reusable confirmation modal --------------------------------------
      const confirmModal = document.getElementById('confirm-modal');
      const confirmOk = document.getElementById('confirm-ok');
      let onConfirmYes = null;
      function showConfirm() { confirmModal.classList.remove('hidden'); confirmModal.classList.add('flex'); }
      function hideConfirm() { confirmModal.classList.add('hidden'); confirmModal.classList.remove('flex'); onConfirmYes = null; }
      // askConfirm(title, text, fn, { okLabel = 'Delete', danger = true })
      const OK_DANGER = 'bg-rose-500 hover:bg-rose-600';
      const OK_NEUTRAL = 'bg-emerald-500 hover:bg-emerald-600';
      function askConfirm(title, text, fn, opts = {}) {
        document.getElementById('confirm-title').textContent = title;
        document.getElementById('confirm-text').textContent = text;
        confirmOk.textContent = opts.okLabel || 'Delete';
        confirmOk.className = `h-10 flex-1 rounded-xl text-sm font-semibold text-white transition active:scale-95 ${opts.danger === false ? OK_NEUTRAL : OK_DANGER}`;
        onConfirmYes = fn;
        showConfirm();
      }
      document.getElementById('confirm-cancel').addEventListener('click', hideConfirm);
      confirmModal.addEventListener('click', (e) => { if (e.target === confirmModal) hideConfirm(); });
      confirmOk.addEventListener('click', async () => {
        const fn = onConfirmYes;
        hideConfirm();
        if (fn) await fn();
      });

      // ---- add habit ---------------------------------------------------------
      let selectedColor = 'emerald';
      const picker = document.getElementById('color-picker');
      picker.innerHTML = Object.entries(COLORS).map(([name, hex]) => `
        <button type="button" data-color="${name}" aria-label="${name}"
          class="h-7 w-7 rounded-full border-2 transition ${name === selectedColor ? 'scale-110 border-slate-400 dark:border-white' : 'border-transparent'}"
          style="background:${hex}"></button>`).join('');
      function setColor(name) {
        selectedColor = name;
        [...picker.children].forEach((c) =>
          c.className = c.className.replace(/scale-110 border-slate-400 dark:border-white|border-transparent/g,
            c.dataset.color === selectedColor ? 'scale-110 border-slate-400 dark:border-white' : 'border-transparent'));
      }
      picker.addEventListener('click', (e) => {
        const b = e.target.closest('[data-color]');
        if (!b) return;
        setColor(b.dataset.color);
      });

      // emoji picker: click the box to open a grid of suggestions
      const emojiInput = document.getElementById('habit-emoji');
      const emojiPop = document.getElementById('emoji-pop');
      const emojiGrid = document.getElementById('emoji-grid');
      emojiGrid.innerHTML = EMOJIS.map((e) =>
        `<button type="button" data-emoji="${e}" class="flex h-9 items-center justify-center rounded-lg text-xl transition hover:bg-slate-100 dark:hover:bg-slate-800">${e}</button>`).join('');
      const showEmojiPop = (show) => emojiPop.classList.toggle('hidden', !(show ?? emojiPop.classList.contains('hidden')));
      emojiInput.addEventListener('click', (e) => { e.stopPropagation(); showEmojiPop(); });
      emojiGrid.addEventListener('click', (e) => {
        const b = e.target.closest('[data-emoji]');
        if (!b) return;
        emojiInput.value = b.dataset.emoji;
        showEmojiPop(false);
      });
      document.addEventListener('click', (e) => { if (!emojiPop.contains(e.target) && e.target !== emojiInput) showEmojiPop(false); });

      // ---- frequency selector ------------------------------------------------
      let freqMode = 'daily';                      // 'daily' | 'weekdays' | 'custom'
      let customDays = new Set([1, 2, 3, 4, 5]);   // JS weekday numbers
      const DAY_CHIPS = [[1, 'M'], [2, 'T'], [3, 'W'], [4, 'T'], [5, 'F'], [6, 'S'], [0, 'S']];
      const seg = document.getElementById('freq-seg');
      const daysBox = document.getElementById('freq-days');

      function currentSchedule() {
        if (freqMode === 'daily') return [0, 1, 2, 3, 4, 5, 6];
        if (freqMode === 'weekdays') return [1, 2, 3, 4, 5];
        return [...customDays];
      }
      function renderFreq() {
        const opts = [['daily', 'Every day'], ['weekdays', 'Weekdays'], ['custom', 'Custom']];
        seg.innerHTML = opts.map(([v, l]) => `
          <button type="button" data-freq="${v}"
            class="rounded-lg px-3 py-1.5 text-xs font-semibold transition ${freqMode === v
              ? 'bg-emerald-500 text-white shadow-sm'
              : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'}">${l}</button>`).join('');
        daysBox.classList.toggle('hidden', freqMode !== 'custom');
        daysBox.classList.toggle('flex', freqMode === 'custom');
        if (freqMode === 'custom') {
          daysBox.innerHTML = DAY_CHIPS.map(([n, l]) => `
            <button type="button" data-day-toggle="${n}"
              class="h-8 w-8 rounded-full text-xs font-semibold transition ${customDays.has(n)
                ? 'bg-emerald-500 text-white'
                : 'bg-slate-100 text-slate-500 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700'}">${l}</button>`).join('');
        }
      }
      seg.addEventListener('click', (e) => {
        const b = e.target.closest('[data-freq]');
        if (!b) return;
        freqMode = b.dataset.freq;
        renderFreq();
      });
      daysBox.addEventListener('click', (e) => {
        const b = e.target.closest('[data-day-toggle]');
        if (!b) return;
        const n = Number(b.dataset.dayToggle);
        customDays.has(n) ? customDays.delete(n) : customDays.add(n);
        if (customDays.size === 0) customDays.add(n); // keep at least one
        renderFreq();
      });
      renderFreq();

      // ---- add / edit habit (one form, two modes) ----------------------------
      let editingId = null;                       // null = create mode
      const habitForm = document.getElementById('habit-form');
      const habitNameInput = document.getElementById('habit-name');
      const habitSubmit = document.getElementById('habit-submit');

      // Reflect a habit's schedule back into the frequency selector.
      function setFreqFromHabit(h) {
        const key = [...schedOf(h)].sort((a, b) => a - b).join(',');
        if (key === '0,1,2,3,4,5,6') freqMode = 'daily';
        else if (key === '1,2,3,4,5') freqMode = 'weekdays';
        else { freqMode = 'custom'; customDays = new Set(key.split(',').map(Number)); }
        renderFreq();
      }
      function resetFormToCreate() {
        editingId = null;
        habitNameInput.value = '';
        emojiInput.value = '✅';
        habitSubmit.textContent = 'Add';
      }
      function enterEditMode(h) {
        editingId = h.id;
        emojiInput.value = h.emoji;
        habitNameInput.value = h.name;
        setColor(COLORS[h.color] ? h.color : 'emerald');
        setFreqFromHabit(h);
        habitSubmit.textContent = 'Save';
        habitForm.classList.remove('hidden');
        habitForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
        habitNameInput.focus();
      }

      habitForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = habitNameInput.value.trim();
        if (!name) return;
        const body = { name, emoji: emojiInput.value.trim() || '✅', color: selectedColor, schedule: currentSchedule() };
        if (editingId) {
          const { ok, data } = await api('/api/habits/' + editingId, { method: 'PATCH', body });
          if (ok) {
            const h = habits.find((x) => x.id === editingId);
            if (h) Object.assign(h, data);
            resetFormToCreate();
            habitForm.classList.add('hidden');
            render();
          }
        } else {
          const { ok, data } = await api('/api/habits', { method: 'POST', body });
          if (ok) {
            habits.push(data);
            resetFormToCreate();
            habitForm.classList.add('hidden');
            render();
          }
        }
      });
      document.getElementById('habit-close').addEventListener('click', () => { resetFormToCreate(); habitForm.classList.add('hidden'); });

      function openCreateForm() {
        resetFormToCreate();
        habitForm.classList.remove('hidden');
        habitForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
        habitNameInput.focus();
      }
      // header + button toggles a fresh "create" form
      document.getElementById('add-btn').addEventListener('click', () => {
        if (habitForm.classList.contains('hidden')) openCreateForm();
        else habitForm.classList.add('hidden');
      });
      // empty-state button — same fresh "create" form
      document.getElementById('empty-add-btn').addEventListener('click', openCreateForm);

      // ---- PWA service worker ------------------------------------------------
      // Registering the SW (+ manifest) is what makes the browser offer its own
      // install affordance beside the URL bar. We intentionally have no in-app
      // install button — we rely on the browser's native install icon.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }

      // ---- iOS install hint (Safari only; dismissible, shown once) ----------
      const iosHint = document.getElementById('ios-install');
      const IOS_HINT_KEY = 'habitrack_ios_hint';
      function maybeShowIosHint() {
        const ua = navigator.userAgent || '';
        const isIOS = /iphone|ipad|ipod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        const standalone = navigator.standalone === true || matchMedia('(display-mode: standalone)').matches;
        if (!isIOS || standalone || localStorage.getItem(IOS_HINT_KEY) === 'dismissed') return;
        iosHint.classList.remove('hidden');
        requestAnimationFrame(() => iosHint.classList.remove('translate-y-4', 'opacity-0'));
      }
      document.getElementById('ios-install-close').addEventListener('click', () => {
        iosHint.classList.add('translate-y-4', 'opacity-0');
        localStorage.setItem(IOS_HINT_KEY, 'dismissed');
        setTimeout(() => iosHint.classList.add('hidden'), 300);
      });

      // ---- data loading ------------------------------------------------------
      const loadError = document.getElementById('load-error');

      // Returns 'ok' | 'unauthorized' | 'forbidden' | 'error'
      async function fetchHabits() {
        try {
          const url = viewing ? `/api/habits?profile=${viewing.id}` : '/api/habits';
          const { ok, status, data } = await api(url);
          if (status === 401) return 'unauthorized';
          if (status === 403) return 'forbidden'; // share was revoked
          if (!ok) return 'error';
          habits = data;
          return 'ok';
        } catch { return 'error'; }
      }

      // The header (logo, date, account chip + menu, theme, presence) is the
      // shared <AppHeader> component; here we only own the app body + view banner.
      const addBtn = document.getElementById('add-btn');
      const viewBanner = document.getElementById('view-banner');
      function enterApp() {
        loadError.classList.add('hidden');
        if (viewing) {
          // read-only mode: banner + no add button (chip is hidden by AppHeader)
          document.getElementById('view-banner-name').textContent = viewing.name;
          viewBanner.classList.remove('hidden'); viewBanner.classList.add('flex');
          addBtn.classList.add('hidden');
          document.getElementById('habit-form').classList.add('hidden');
        } else {
          viewBanner.classList.add('hidden'); viewBanner.classList.remove('flex');
          addBtn.classList.remove('hidden');
        }
        render();
        initRealtime();
        setTimeout(maybeShowIosHint, 1200); // let content paint first
      }

      async function refresh() {
        if (!token) return;
        const r = await fetchHabits();
        if (r === 'ok') { render(); loadError.classList.add('hidden'); }
        else if (r === 'unauthorized') { signOut(); }
        else if (r === 'forbidden') { exitViewMode(); } // access was revoked
      }
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') refresh();
      });
      window.addEventListener('pageshow', (e) => { if (e.persisted) refresh(); });

      function signOut() {
        token = ''; localStorage.removeItem(TK);
        location.href = '/profile';
      }

      // Leave read-only view of a shared profile (reload to rebind realtime).
      function exitViewMode() {
        localStorage.removeItem(VIEW);
        location.reload();
      }
      document.getElementById('view-exit').addEventListener('click', exitViewMode);

      // ---- realtime: apply another device's change surgically ---------------
      function applyRemote(p) {
        if (!p || !p.type) return;
        if (p.type === 'checkin') {
          const h = habits.find((x) => x.id === p.habitId);
          if (!h) return;
          const has = h.days.includes(p.day);
          if (p.checked && !has) h.days = [...h.days, p.day];
          else if (!p.checked && has) h.days = h.days.filter((d) => d !== p.day);
          else return;
        } else if (p.type === 'add') {
          if (p.habit && !habits.some((x) => x.id === p.habit.id)) habits.push(p.habit);
          else return;
        } else if (p.type === 'delete') {
          if (!habits.some((x) => x.id === p.id)) return;
          habits = habits.filter((x) => x.id !== p.id);
          expanded.delete(p.id); calView.delete(p.id);
        } else if (p.type === 'update') {
          const h = habits.find((x) => x.id === p.habit.id);
          if (!h) return;
          Object.assign(h, p.habit); // days aren't in the payload, so they're preserved
        } else if (p.type === 'reorder') {
          const pos = new Map(p.ids.map((id, i) => [id, i]));
          habits.sort((a, b) => (pos.get(a.id) ?? 1e9) - (pos.get(b.id) ?? 1e9));
        } else return;
        render();
      }

      let realtimeStarted = false;
      async function initRealtime() {
        if (realtimeStarted || !profile) return;
        realtimeStarted = true;
        try {
          const { ok, data: cfg } = await api('/api/rt-config');
          if (!ok || !cfg.enabled) return;
          const pusher = await connectRealtime({ key: cfg.key, cluster: cfg.cluster, channel: `habitrack-${dataId()}`, onEvent: applyRemote });
          const setId = () => { socketId = pusher.connection.socket_id; };
          pusher.connection.bind('connected', setId);
          if (pusher.connection.socket_id) setId();
        } catch { /* best-effort */ }
      }

      // ---- boot -------------------------------------------------------------
      // Middleware guarantees a valid session for this page. Profile info for the
      // UI lives in localStorage; if it's missing we can't label things, so bounce.
      async function boot() {
        if (viewing && !profile) { localStorage.removeItem(VIEW); viewing = null; }
        if (!profile) { location.href = '/profile'; return; }

        if (!viewing) {
          // own profile: render the SSR'd habits immediately, then reconcile.
          habits = initialHabits;
          enterApp();
          const r = await fetchHabits();
          if (r === 'ok') render();
          else if (r === 'unauthorized') signOut();
          return;
        }

        // view-mode: SSR data is our own, not the viewed profile — fetch it.
        let r = await fetchHabits();
        if (r === 'forbidden') { localStorage.removeItem(VIEW); viewing = null; habits = initialHabits; enterApp(); return; }
        if (r === 'ok') { enterApp(); return; }
        if (r === 'unauthorized') { location.href = '/profile'; return; }
        loadError.classList.remove('hidden'); // network error — keep shell, show error
      }
      boot();
    </script>
  </body>
</html>
