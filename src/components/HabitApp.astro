---
import '../styles/global.css';
import AppHeader from './AppHeader.astro';

// The whole habit app (list, calendars, Today card, add/edit form), rendered by
// two routes that fetch their own data:
//   index.astro  — the signed-in app. `viewing` is null; the client may still
//                  enter read-only share-preview mode from localStorage.
//   p/[id].astro — a PUBLIC profile, no session at all. `viewing` is SSR'd, which
//                  puts the page in read-only mode from the first paint and tells
//                  the client that `initialHabits` belongs to the viewed profile.
//   profile/demo  — the DEMO, no session. Fully WRITABLE, but every mutation is
//                  applied in localStorage by lib/demo.js instead of the API, so
//                  strangers can use the whole app without touching the database.
// One `mode` decides the surface, so there are no illegal combinations and each
// branch below reads it rather than re-deriving from a pile of booleans:
//   'app'    — signed in, writes to the API
//   'public' — read-only, session-less  (`viewing` names whose profile it is)
//   'demo'   — writable, session-less, writes to localStorage
// props: mode, initialHabits=[], initialProfile={id,name,admin}|null, viewing={id,name}|null
const { mode = 'app', initialHabits = [], initialProfile = null, viewing = null } = Astro.props;
const publicView = mode === 'public';

// The whole client-side starting state travels in ONE script tag, decoded once.
const state = { mode, habits: initialHabits, profile: initialProfile, viewing };
const embed = (v) => JSON.stringify(v ?? null).replace(/</g, '\\u003c');
---

<!-- data-mode is how AppHeader's own script knows which surface it's on; without it
     it would re-derive the mode from localStorage and disagree with the SSR props. -->
<html lang="en" class="h-full" data-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{mode === 'demo' ? 'Demo — Habitrack' : publicView ? `${viewing.name}’s habits — Habitrack` : 'Habitrack — build better habits'}</title>
    <meta name="description" content="A simple, beautiful habit tracker." />
    <meta name="robots" content="noindex, nofollow" />

    <!-- PWA / iOS home-screen -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Habitrack" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // The signed-in route is gated server-side by middleware (redirects to
      // /profile before any HTML is sent) and the public route needs no session,
      // so no client-side auth guard is needed here.
      // Apply theme before paint to avoid flash
      const t = localStorage.getItem('theme');
      if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="h-full bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 font-sans antialiased">

    <!-- Delete confirmation -->
    <div id="confirm-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 px-6 backdrop-blur-sm">
      <div class="w-full max-w-xs rounded-2xl bg-white p-5 shadow-xl dark:bg-slate-900">
        <p id="confirm-title" class="text-base font-semibold">Are you sure?</p>
        <p id="confirm-text" class="mt-1.5 text-sm text-slate-500 dark:text-slate-400"></p>
        <div class="mt-5 flex gap-2">
          <button id="confirm-cancel" class="h-10 flex-1 rounded-xl bg-slate-100 text-sm font-semibold text-slate-700 transition hover:bg-slate-200 active:scale-95 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Cancel</button>
          <button id="confirm-ok" class="h-10 flex-1 rounded-xl bg-rose-500 text-sm font-semibold text-white transition hover:bg-rose-600 active:scale-95">Delete</button>
        </div>
      </div>
    </div>

    <!-- iOS-only install hint (Safari has no auto-install / address-bar icon).
         Fixed bottom banner, dismissible, shown once — never on desktop/Chrome. -->
    <div id="ios-install" class="fixed inset-x-0 bottom-0 z-40 hidden translate-y-4 px-3 pb-[calc(env(safe-area-inset-bottom)+10px)] opacity-0 transition-all duration-300">
      <div class="mx-auto flex max-w-md items-center gap-3 rounded-2xl border border-slate-200 bg-white/95 p-3 shadow-lg backdrop-blur dark:border-slate-700 dark:bg-slate-900/95">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 8.25H7.5a2.25 2.25 0 0 0-2.25 2.25v9a2.25 2.25 0 0 0 2.25 2.25h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25H15m0-3-3-3m0 0-3 3m3-3V15" /></svg>
        </span>
        <p class="min-w-0 flex-1 text-xs leading-snug text-slate-600 dark:text-slate-300">
          Install Habitrack — tap <span class="font-semibold text-slate-900 dark:text-white">Share</span>, then <span class="font-semibold text-slate-900 dark:text-white">Add to Home Screen</span>.
        </p>
        <button id="ios-install-close" aria-label="Dismiss" class="shrink-0 rounded-lg p-1.5 text-slate-400 transition hover:text-slate-600 dark:hover:text-slate-200">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
        </button>
      </div>
    </div>

    <div class="mx-auto max-w-3xl px-4 pb-24 pt-8 sm:pt-12">

      <!-- Header (shared with /profile via the AppHeader component). A public view
           has no session, so it swaps the app actions for a sign-in link. -->
      <AppHeader showAdd={mode !== 'public'} showOverview={mode === 'app'} showSignIn={mode !== 'app'} />

      <!-- Demo banner: says plainly that nothing leaves the browser, and offers a
           reset back to the seed. Only rendered on /profile/demo. -->
      {mode === 'demo' && (
        <div class="mb-6 flex items-center justify-between gap-2 rounded-xl border border-sky-200 bg-sky-50 px-4 py-2.5 text-sm text-sky-800 dark:border-sky-900/60 dark:bg-sky-950/40 dark:text-sky-300">
          <span class="flex min-w-0 items-center gap-2">
            <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" /></svg>
            <span class="truncate">Demo — try anything. Changes are saved in this browser only.</span>
          </span>
          <button id="demo-reset" class="shrink-0 rounded-lg px-2.5 py-1 text-xs font-semibold text-sky-800 transition hover:bg-sky-100 dark:text-sky-200 dark:hover:bg-sky-900/50">Reset</button>
        </div>
      )}

      <!-- Read-only banner: shown when viewing a profile shared with you (toggled by
           JS, since that's a client-only mode) or a public one (SSR'd visible, so a
           public link never paints as if it were your own app). -->
      <div id="view-banner" class:list={['mb-6 items-center justify-between gap-2 rounded-xl border border-amber-200 bg-amber-50 px-4 py-2.5 text-sm text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-300', publicView ? 'flex' : 'hidden']}>
        <span class="flex min-w-0 items-center gap-2">
          <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
          <span class="truncate">Viewing <span id="view-banner-name" class="font-semibold">{publicView ? viewing.name : ''}</span> · read-only</span>
        </span>
        <button id="view-exit" class="shrink-0 rounded-lg px-2.5 py-1 text-xs font-semibold text-amber-800 transition hover:bg-amber-100 dark:text-amber-200 dark:hover:bg-amber-900/50">Exit</button>
      </div>

      <div id="load-error" class="mb-6 hidden rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700 dark:border-rose-900 dark:bg-rose-950/50 dark:text-rose-300">
        Couldn't reach the server. Check your connection and reload.
      </div>

      <!-- Kind switcher: normal habits vs streak (quit/abstain) trackers. The
           active tab also decides what the + button creates. -->
      <div id="kind-tabs" class="mb-6 grid grid-cols-2 gap-1 rounded-xl bg-slate-100 p-1 text-sm font-semibold dark:bg-slate-800/60">
        <button type="button" data-tab="normal" class="rounded-lg py-2 transition">Habits</button>
        <button type="button" data-tab="streak" class="rounded-lg py-2 transition">Streaks</button>
      </div>

      <!-- Today progress: one ring per track — habits (done/due today) and quits
           (clean vs slipped today). Shows on both tabs; each ring appears only if
           that track has anything to show today. Rings are filled by JS. -->
      <section id="today-card" class="mb-4 hidden rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:mb-6 sm:p-5">
        <div class="flex items-center justify-between gap-4">
          <div class="min-w-0">
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Today's progress</p>
            <p id="today-status" class="mt-1 text-sm font-semibold">&nbsp;</p>
          </div>
          <div id="today-rings" class="flex shrink-0 items-start gap-3 sm:gap-4"></div>
        </div>
      </section>

      <!-- Add habit (toggled by the + in the header) -->
      <form id="habit-form" class="relative mb-6 hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <button type="button" id="habit-close" aria-label="Close" title="Close"
          class="absolute right-2.5 top-2.5 z-10 flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800 dark:hover:text-slate-200">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
        </button>

        <!-- Kind is decided by the active tab (Habits → build, Streaks → quit);
             the form heading reflects it. -->
        <p id="form-heading" class="mb-3 mr-10 text-sm font-semibold"></p>

        <div class="flex items-start gap-2">
          <!-- Leading emoji tile (fixed-width rail); the pencil badge lives over it -->
          <div class="relative shrink-0">
            <input id="habit-emoji" name="emoji" maxlength="2" value="✅" aria-label="Emoji, tap to change" title="Tap to change the emoji" readonly
              class="h-11 w-12 cursor-pointer rounded-xl border border-slate-200 bg-slate-50 text-center text-xl outline-none focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-800" />
            <span class="pointer-events-none absolute -bottom-1 -right-1 flex h-[18px] w-[18px] items-center justify-center rounded-full bg-emerald-500 text-white shadow ring-2 ring-white dark:ring-slate-900">
              <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24"><path d="M21.731 2.269a2.625 2.625 0 0 0-3.712 0l-1.157 1.157 3.712 3.712 1.157-1.157a2.625 2.625 0 0 0 0-3.712ZM19.513 8.199l-3.712-3.712-8.4 8.4a5.25 5.25 0 0 0-1.32 2.214l-.8 2.685a.75.75 0 0 0 .933.933l2.685-.8a5.25 5.25 0 0 0 2.214-1.32l8.4-8.4Z" /></svg>
            </span>
            <div id="emoji-pop" class="absolute left-0 top-full z-20 mt-1.5 hidden w-64 rounded-xl border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900">
              <input id="emoji-search" type="text" autocomplete="off" placeholder="Search emoji…"
                class="mb-2 w-full rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-sm outline-none focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-800" />
              <div id="emoji-grid" class="no-scrollbar grid max-h-52 grid-cols-6 gap-1 overflow-y-auto"></div>
              <p id="emoji-none" class="hidden py-4 text-center text-xs text-slate-400 dark:text-slate-500">No emoji match that.</p>
            </div>
          </div>
          <!-- Content spine: input, colors, and frequency all share this left edge -->
          <div class="min-w-0 flex-1">
            <div class="flex gap-2">
              <input id="habit-name" name="name" placeholder="e.g. Morning run" autocomplete="off" required
                class="h-11 min-w-0 flex-1 rounded-xl border border-slate-200 bg-slate-50 px-3.5 text-sm outline-none focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-800" />
              <button type="submit" id="habit-submit"
                class="h-11 shrink-0 rounded-xl bg-emerald-500 px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600 active:scale-95">Add</button>
            </div>

            <p class="mb-1.5 mt-5 text-xs font-medium text-slate-500 dark:text-slate-400">Color</p>
            <div id="color-picker" class="flex flex-wrap gap-2"></div>

            <div id="freq-section">
              <p class="mb-1.5 mt-4 text-xs font-medium text-slate-500 dark:text-slate-400">How often?</p>
              <div id="freq-seg" class="flex flex-wrap gap-1.5"></div>
              <div id="freq-days" class="mt-2 hidden flex-wrap gap-1.5"></div>
            </div>

            <div id="start-row" class="mt-4">
              <p id="start-label" class="mb-1.5 text-xs font-medium text-slate-500 dark:text-slate-400">Existing streak?</p>
              <div id="start-seg" class="flex flex-wrap gap-1.5"></div>
              <input type="date" id="start-custom" aria-label="Start date"
                class="mt-2 hidden h-10 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm outline-none focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-800" />
            </div>
          </div>
        </div>
      </form>

      <!-- Weekday header -->
      <div id="week-header" class="mb-2 px-4"></div>

      <!-- Habit list -->
      <main id="habit-list" class="space-y-2"></main>

      <div id="empty-state" class="hidden py-10 text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-50 text-3xl dark:bg-emerald-950/40">🌱</div>
        <p id="empty-title" class="text-base font-semibold">Start your first habit</p>
        <p id="empty-sub" class="mx-auto mt-1 max-w-xs text-sm text-slate-400 dark:text-slate-500">Track something you want to do regularly — check it off with one tap a day.</p>
      </div>

      <!-- Permanent add button under the list. The small ＋ in the header is easy to
           miss, so this stays visible however many habits there are; render() sets
           its label from the active tab and hides it in read-only views. -->
      <button id="add-btn-bottom"
        class:list={['mx-auto mt-4 w-full max-w-xs items-center justify-center gap-1.5 rounded-xl border border-dashed border-emerald-300 py-3 text-sm font-semibold text-emerald-600 transition hover:border-emerald-400 hover:bg-emerald-50 dark:border-emerald-800 dark:text-emerald-400 dark:hover:bg-emerald-950/40', publicView ? 'hidden' : 'flex']}>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        <span id="add-btn-bottom-label">Add a habit</span>
      </button>
    </div>

    <script id="initial-state" type="application/json" is:inline set:html={embed(state)}></script>

    <script>
      import { COLORS, COLORS_DARK, MONTHS, WD, TODAY, BACKFILL_DAYS, iso, pad2, addDays, dow, schedOf, stats, windowStart, heatmapBlock, githubGraph, streakGraph, isStreak, startOf, activeFromOf, SLIP_COLOR, escapeHtml, connectRealtime, apiFetch } from '../lib/compute.js';
      import { demoApi, loadDemo, saveDemo, clearDemo, trackDemoVisit } from '../lib/demo.js';

      // Earliest day a check-in can still be marked (today − (BACKFILL_DAYS−1)).
      const BACKFILL_START = addDays(TODAY, -(BACKFILL_DAYS - 1));

      // The entire server-rendered starting state, decoded once. `mode` is the
      // surface ('app' | 'public' | 'demo'); see the frontmatter. The habits render
      // immediately from here, with no flash and no fetch.
      let SSR = {};
      try { SSR = JSON.parse(document.getElementById('initial-state')?.textContent || '{}') || {}; } catch {}
      const MODE = SSR.mode || 'app';
      const publicView = MODE === 'public';   // read-only, session-less
      const demoMode = MODE === 'demo';       // writable, but into localStorage
      const initialHabits = SSR.habits || [];

      // ---- constants ---------------------------------------------------------
      // Emoji suggestions for the habit picker, as [emoji, searchKeywords]. The
      // popup scrolls and is searchable, so this list can grow freely — add a new
      // ['🙂','keyword synonyms'] entry to the relevant category row below. Keep
      // each emoji listed once (keywords can cover multiple contexts).
      const EMOJIS = [
        // marks & motivation
        ['✅','check done complete tick'],['⭐','star favorite'],['🔥','fire streak hot'],['❤️','heart love'],['🎯','target goal aim focus'],['🏆','trophy win achievement'],['📌','pin remember'],['⏰','alarm clock time wake'],
        // movement & fitness
        ['🏃','run running jog cardio exercise'],['🚶','walk walking steps'],['🚴','bike cycling ride'],['🏊','swim swimming pool'],['🏋️','gym workout lift weights strength'],['🧘','yoga meditate stretch calm'],['💪','muscle strength strong gym'],['🤸','gymnastics exercise cartwheel'],['🧗','climb climbing bouldering'],['⛹️','basketball sport ball'],['🤾','handball sport'],['🚣','row rowing boat'],['⚽','soccer football sport'],['🏀','basketball sport'],['🎾','tennis sport'],['🏸','badminton sport'],['🥊','boxing fight gym'],['⛳','golf sport'],['🏓','ping pong table tennis'],['🥾','hike hiking boot walk'],
        // fruit & veg
        ['🍎','apple fruit food'],['🍏','apple green fruit food'],['🍌','banana fruit food'],['🍊','orange fruit citrus food'],['🍓','strawberry berry fruit food'],['🫐','blueberry berry fruit food'],['🍇','grapes fruit food'],['🍉','watermelon melon fruit food'],['🍒','cherry cherries fruit food'],['🍑','peach fruit food'],['🥭','mango fruit food'],['🍍','pineapple fruit food'],['🥝','kiwi fruit food'],['🥥','coconut fruit food'],['🍅','tomato veg vegetable food'],['🥑','avocado fruit veg food'],['🥦','broccoli veg vegetable green food'],['🥕','carrot veg vegetable food'],['🌽','corn maize veg food'],['🥒','cucumber pickle veg food'],['🫑','pepper bell veg food'],['🥬','lettuce greens salad veg food'],['🧄','garlic veg food'],['🧅','onion veg food'],['🍠','sweet potato yam veg food'],['🥔','potato veg vegetable food'],
        // meals & food
        ['🍞','bread carb food'],['🥐','croissant bread food'],['🥖','baguette bread food'],['🧀','cheese dairy food'],['🥚','egg protein food'],['🍳','egg fry cooking breakfast food'],['🥩','steak meat protein food'],['🍗','chicken poultry meat protein food'],['🍖','meat protein food'],['🥓','bacon meat food'],['🌭','hotdog food'],['🍔','burger hamburger fast junk food quit'],['🍟','fries chips fast food'],['🍕','pizza italian food'],['🌮','taco mexican food'],['🌯','burrito wrap mexican food'],['🥙','pita wrap kebab food'],['🧆','falafel food'],['🥪','sandwich food'],['🥗','salad healthy veg food'],['🍝','pasta spaghetti italian food'],['🍜','ramen noodles soup food'],['🍲','stew soup pot food'],['🍛','curry rice food'],['🍣','sushi japanese fish food'],['🍱','bento lunch box japanese food'],['🥟','dumpling food'],['🍤','shrimp prawn fried food'],['🍚','rice food'],['🍙','rice ball onigiri food'],['🥡','takeout box food'],['🍿','popcorn snack food'],['🧂','salt seasoning food'],['🥜','peanut nuts snack food'],
        // sweets & treats
        ['🍩','donut doughnut sweet dessert food'],['🍪','cookie biscuit sweet dessert food'],['🎂','cake birthday sweet dessert food'],['🍰','cake slice sweet dessert food'],['🧁','cupcake sweet dessert food'],['🥧','pie sweet dessert food'],['🍫','chocolate candy sweet food'],['🍬','candy sweet food'],['🍭','lollipop candy sweet food'],['🍮','pudding custard flan sweet dessert food'],['🍯','honey sweet food'],['🍦','ice cream soft serve sweet dessert food'],['🍨','ice cream sweet dessert food'],
        // drinks
        ['💧','water drink hydrate hydration'],['☕','coffee caffeine drink'],['🍵','tea green drink'],['🧃','juice box drink'],['🥤','soda soft drink cup'],['🧋','boba bubble tea drink milk'],['🥛','milk dairy drink'],['🍺','beer alcohol drink quit sober'],['🍷','wine alcohol drink quit'],['🍶','sake alcohol drink'],['🥂','champagne celebrate alcohol drink'],['🧉','mate drink'],
