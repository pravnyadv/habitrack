        ['🎨','art paint draw creative'],['🎸','guitar music instrument play'],['🎹','piano keyboard music instrument play'],['🎧','music headphones listen'],['🎤','sing microphone karaoke music'],['🎬','film movie video shoot'],['📷','photo camera photography'],['🎮','game gaming play video controller'],['♟️','chess strategy game'],['🧶','knit yarn crochet craft'],['🪡','sew sewing needle craft'],['🎲','dice board game'],['🎻','violin music instrument'],['🥁','drums music instrument'],['📸','photo camera photography selfie'],
        // spirit & calm
        ['🙏','pray prayer gratitude thanks meditate'],['🧎','kneel pray prayer'],['🕉️','om hindu spiritual meditate'],['☮️','peace calm'],['🌙','moon night sleep evening'],['☀️','sun morning day sunshine'],['🕯️','candle calm meditate light'],['📿','beads prayer meditate mala'],
        // nature & outdoors
        ['🌱','plant seedling grow garden nature'],['🌿','herb plant green nature'],['🌳','tree nature outdoors'],['🌸','flower blossom spring nature'],['🏔️','mountain hike nature outdoors'],['🏕️','camp camping tent outdoors nature'],['🌊','wave sea ocean water swim'],['🚶‍♀️','walk walking woman steps'],['🐕','dog pet walk animal'],['🐈','cat pet animal'],['🌻','sunflower flower nature'],['🍃','leaf leaves wind nature'],
        // home, money & chores
        ['🧹','clean sweep broom chore tidy'],['🧺','laundry basket chore wash clothes'],['🛒','shop cart grocery shopping'],['💰','money save savings budget cash'],['💵','money cash dollar budget'],['🏦','bank money finance save'],['📈','invest stocks money growth chart'],['📵','no phone offline screen focus'],['📞','call phone contact'],['🔧','fix tool repair maintenance'],['🪥','toothbrush brush teeth dental hygiene'],
        // quitting & vices
        ['🚭','no smoking quit cigarette stop'],['🎰','gamble gambling casino quit'],['🚬','cigarette smoke smoking quit'],['📱','phone screen scroll social quit'],['🕹️','game gaming screen quit'],
      ];

      let habits = [];
      const expanded = new Set();

      // Which kind of tracker the main list shows: 'normal' habits or 'streak'
      // (quit/abstain) trackers. Persisted so the tab sticks across reloads.
      const KIND_TAB = 'habitrack_tab';
      let activeTab = 'normal';
      try { const t = localStorage.getItem(KIND_TAB); if (t === 'streak' || t === 'normal') activeTab = t; } catch {}
      function setTab(t) { activeTab = t; try { localStorage.setItem(KIND_TAB, t); } catch {} }

      // ---- auth: signed token + selected profile (both in localStorage) ------
      const TK = 'habitrack_token';
      const PID = 'habitrack_profile';
      const VIEW = 'habitrack_viewing';
      let token = localStorage.getItem(TK) || '';
      let profile = null; // { id, name }
      try { profile = JSON.parse(localStorage.getItem(PID) || 'null'); } catch {}
      // PWA: the cookie can be valid (server let us in) while localStorage is empty
      // (iOS copies cookies into an installed app, not localStorage). Hydrate the
      // profile from the SSR'd, cookie-derived identity so we don't bounce to
      // /profile. Same-origin API calls authenticate on the cookie, so a missing
      // token is fine.
      if (!profile && SSR.profile) {
        profile = SSR.profile;
        localStorage.setItem(PID, JSON.stringify(profile));
      }
      // When set ({id,name}), the app shows that profile read-only instead of our
      // own. Two ways in: a public link (SSR'd, works with no session, and its
      // habits are what we rendered) or the share preview the Switch tab stores in
      // localStorage (persisted so it survives the reload that rebinds realtime).
      let viewing = SSR.viewing || null;
      if (!viewing) { try { viewing = JSON.parse(localStorage.getItem(VIEW) || 'null'); } catch {} }
      // Read-only covers both ways in, so the chrome rules key off this one flag.
      const readOnly = () => !!viewing;
      const dataId = () => (viewing ? viewing.id : (profile && profile.id));
      let socketId = null; // our realtime socket, sent so the server excludes us
      // Bound API client: reads the live token + socketId on every call. In demo mode
      // every call is answered locally, so no request ever leaves the page.
      const api = demoMode
        ? async (path, opts = {}) => demoApi(path, opts, habits)
        : (path, opts = {}) => apiFetch(path, { token, socketId, ...opts });
      // Demo sandbox: persist after a change, NOT from render(). render() also runs
      // for pure UI (expanding a card, paging the calendar, switching tabs), and each
      // call would re-stringify every habit and synchronously hit localStorage.
      const persist = demoMode ? () => saveDemo(habits) : () => {};

      // ---- rendering ---------------------------------------------------------
      const list = document.getElementById('habit-list');
      const weekHead = document.getElementById('week-header');

      // Mobile: 7 equal columns — the name sits on its own full-width row above
      // the checks. Desktop (sm+): name column + 7 fixed day columns on one row.
      const GRID = 'grid grid-cols-7 gap-y-1 sm:grid-cols-[minmax(0,1fr)_repeat(7,2.25rem)] sm:gap-y-0 items-center';
      const last7 = () => Array.from({ length: 7 }, (_, i) => addDays(TODAY, i - 6));

      const CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px]"><path d="M4.5 12.75l6 6 9-13.5"/></svg>';
      const CROSS = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M6 18L18 6M6 6l12 12"/></svg>';
      const FLAME = '<svg viewBox="0 0 24 24" fill="currentColor" class="h-3 w-3"><path d="M12.963 2.286a.75.75 0 0 0-1.071-.136 9.742 9.742 0 0 0-3.539 6.177A7.547 7.547 0 0 1 6.648 6.61a.75.75 0 0 0-1.152-.081A9 9 0 1 0 15.68 4.534a7.46 7.46 0 0 1-2.717-2.248Z"/><path d="M15.75 14.25a3.75 3.75 0 1 1-7.313-1.172c.628.465 1.35.81 2.133 1.005a5.99 5.99 0 0 1 1.925-3.547 3.75 3.75 0 0 1 3.255 3.714Z"/></svg>';

      function weekHeader() {
        const cols = last7().map((d) => {
          const dd = new Date(d + 'T00:00:00');
          const isToday = d === TODAY;
          return `<div class="flex flex-col items-center leading-tight ${isToday ? 'text-slate-900 dark:text-white' : 'text-slate-400 dark:text-slate-500'}">
              <span class="text-[11px] font-medium">${dd.toLocaleDateString('en-US', { weekday: 'short' })}</span>
              <span class="text-[11px] ${isToday ? 'font-semibold' : ''}">${dd.getDate()}</span>
            </div>`;
        }).join('');
        // leading empty cell only exists on desktop (name column)
        weekHead.innerHTML = `<div class="${GRID}"><span class="hidden sm:block"></span>${cols}</div>`;
      }

      const REST = '<span class="h-1 w-1 rounded-full bg-slate-200 dark:bg-slate-700"></span>';
      // Streak 7-day strip: every day is clean (✓, color) by default from the
      // start date; slips (habit.days) show a red ✕. Tapping toggles a slip — so
      // you can mark "I slipped yesterday" if you forgot to open the app today.
      function weekCellsStreak(habit) {
        const slips = new Set(habit.days);
        const color = COLORS[habit.color] || COLORS.emerald;
        const start = startOf(habit);
        return last7().map((d) => {
          const isToday = d === TODAY;
          const todayBg = isToday ? 'rounded-lg bg-slate-50/70 dark:bg-slate-800/40' : '';
          if (d < start) {
            // before the streak began — not tracked
            return `<div class="flex h-9 items-center justify-center opacity-70" title="${d} · before start">${REST}</div>`;
          }
          const slip = slips.has(d);
          const editable = !viewing && d >= BACKFILL_START;
          const marker = slip
            ? `<span class="text-rose-500 dark:text-rose-400">${CROSS}</span>`
            : `<span style="color:${color}">${CHECK}</span>`;
          const title = `${d}${slip ? ' · slipped' : ' · clean'}`;
          if (!editable) return `<div class="flex h-9 items-center justify-center ${todayBg}" title="${title}">${marker}</div>`;
          return `<button data-day="${d}" data-habit="${habit.id}"
              class="day flex h-9 touch-manipulation items-center justify-center rounded-lg transition hover:bg-slate-50 active:scale-90 dark:hover:bg-slate-800/60 ${todayBg}"
              title="${title}">${marker}</button>`;
        }).join('');
      }
      function weekCells(habit) {
        if (isStreak(habit)) return weekCellsStreak(habit);
        const set = new Set(habit.days);
        const sched = schedOf(habit);
        const color = COLORS[habit.color] || COLORS.emerald;
        return last7().map((d) => {
          const isToday = d === TODAY;
          if (!sched.has(dow(d))) {
            // rest day — not tracked, not clickable
            return `<div class="flex h-9 items-center justify-center opacity-70" title="${d} · rest day">${REST}</div>`;
          }
          const done = set.has(d);
          const editable = !viewing && d >= BACKFILL_START;   // today + the backfill window
          const todayBg = isToday ? 'rounded-lg bg-slate-50/70 dark:bg-slate-800/40' : '';
          // marker: done ✓ (color) · markable ◯ (hollow ring) · missed & locked ✕ (faint)
          const marker = done
            ? `<span style="color:${color}">${CHECK}</span>`
            : editable
              ? `<span class="h-[18px] w-[18px] rounded-full border-2 ${isToday ? '' : 'border-slate-300 dark:border-slate-600'}"${isToday ? ` style="border-color:${color}"` : ''}></span>`
              : `<span class="text-slate-300 dark:text-slate-600">${CROSS}</span>`;
          if (!editable) {
            return `<div class="flex h-9 items-center justify-center ${todayBg}" title="${d}${done ? ' · done' : ''}">${marker}</div>`;
          }
          return `<button data-day="${d}" data-habit="${habit.id}"
              class="day flex h-9 touch-manipulation items-center justify-center rounded-lg transition hover:bg-slate-50 active:scale-90 dark:hover:bg-slate-800/60 ${todayBg}"
              title="${d}${done ? ' · done' : ''}">${marker}</button>`;
        }).join('');
      }

      // ---- LEVEL 1: single-month calendar (current month by default) ---------
      const calView = new Map(); // habitId -> {y, m} of the month being viewed
      function getCalView(id) {
        if (!calView.has(id)) {
          const d = new Date(TODAY + 'T00:00:00');
          calView.set(id, { y: d.getFullYear(), m: d.getMonth() });
        }
        return calView.get(id);
      }

      function calendarGrid(habit) {
        const { y, m } = getCalView(habit.id);
        const set = new Set(habit.days);
        const sched = schedOf(habit);
        const color = COLORS[habit.color] || COLORS.emerald;
        const colorDark = COLORS_DARK[habit.color] || COLORS_DARK.emerald;
        const t = new Date(TODAY + 'T00:00:00');
        const atCurrent = (y === t.getFullYear() && m === t.getMonth());
        const monthLabel = new Date(y, m, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

        const firstDow = (new Date(y, m, 1).getDay() + 6) % 7; // Mon=0
        const daysInMonth = new Date(y, m + 1, 0).getDate();

        // Streak habits: every day is clean from the start date; habit.days = slips.
        const streak = isStreak(habit);

        // habit's active-from date — nothing before it can be "missed" (the habit
        // didn't exist / streak hadn't begun). Streaks start at their start date;
        // normal habits use the shared earlier-of-created/first-checkin helper.
        const activeFrom = streak ? startOf(habit) : activeFromOf(habit);

        // Weekday headers: medium/secondary gray structural labels.
        const wdRow = WD.map((w) => `<div class="text-center text-[11px] font-medium text-slate-500 dark:text-slate-400">${w}</div>`).join('');

        // Hybrid streak-tile calendar. Each cell is an aspect-square grid slot;
        // an absolutely-centered inner "tile" carries the fill, the number sits
        // centered on top. Columns touch (gap-x-0) so full-width done tiles form
        // one continuous capsule; corners square on any side that abuts another
        // done day (same-row link or row-wrap), rounded otherwise.
        const R = 12;                        // outer corner radius (px)
        const HGT = '78%';                   // tile height within the square cell
        const tint = `${color}20`;           // ~12% tint of the habit color (missed)
        const CTR = 'absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2';
        // done numbers are 500 (heavier); every other state is 400 — weight is
        // added per-state below, not baked into NUM.
        const NUM = `${CTR} z-10 text-sm tabular-nums`;

        // Cells are inert <div>s when read-only (viewing a share) OR older than the
        // backfill window — history you can see but not rewrite. Within the window
        // (and today) they're tappable buttons.
        const ro = !!viewing;
        const editableDay = (ds) => !ro && ds >= BACKFILL_START && ds <= TODAY;
        const cellOpen = (ds, title) => editableDay(ds)
          ? `<button data-day="${ds}" data-habit="${habit.id}" class="day relative aspect-square touch-manipulation transition active:opacity-70" title="${title}">`
          : `<div class="relative aspect-square" title="${title}">`;
        const cellClose = (ds) => editableDay(ds) ? '</button>' : '</div>';

        // Filled capsule cell (a done day, or a clean streak day). Squares the side
        // that abuts a same-state neighbor so consecutive days form one continuous
        // bar; `near` is the neighbor predicate (set.has for normal, isClean for streak).
        const capsuleCell = (ds, d, near, title) => {
          const leftSq = near(addDays(ds, -1)), rightSq = near(addDays(ds, 1));
          const full = leftSq || rightSq;
          const br = `${leftSq ? 0 : R}px ${rightSq ? 0 : R}px ${rightSq ? 0 : R}px ${leftSq ? 0 : R}px`;
          const fill = `<span class="${CTR}" style="width:${full ? '100%' : '80%'};height:${HGT};background:${color};border-radius:${br}"></span>`;
          return `${cellOpen(ds, title)}${fill}<span class="${NUM} font-medium text-white">${d}</span>${cellClose(ds)}`;
        };

        let cells = '';
        for (let i = 0; i < firstDow; i++) cells += '<div></div>';
        for (let d = 1; d <= daysInMonth; d++) {
          const ds = `${y}-${pad2(m + 1)}-${pad2(d)}`;
          const future = ds > TODAY;
          const beforeActive = activeFrom && ds < activeFrom;
          const scheduled = sched.has(new Date(y, m, d).getDay());
          const done = set.has(ds);
          const isToday = ds === TODAY;

          // Streak: clean days (color) connect into one capsule; slips are red.
          if (streak) {
            const slip = set.has(ds);
            const isClean = (x) => x >= activeFrom && x <= TODAY && !set.has(x);
            if (!future && !beforeActive && !slip) {
              cells += capsuleCell(ds, d, isClean, ds + ' · clean');
            } else if (slip) {
              const fill = `<span class="${CTR}" style="width:80%;height:${HGT};background:${SLIP_COLOR};border-radius:10px"></span>`;
              cells += `${cellOpen(ds, ds + ' · slipped')}${fill}<span class="${NUM} font-medium text-white">${d}</span>${cellClose(ds)}`;
            } else {
              cells += `<div class="relative flex aspect-square items-center justify-center text-sm font-normal tabular-nums text-slate-500 dark:text-slate-400">${d}</div>`;
            }
            continue;
          }

          if (done) {
            cells += capsuleCell(ds, d, (x) => set.has(x), ds + ' · done');
          } else if (isToday && scheduled) {
            // today, not done — transparent tile with an inset ring in habit color
            const fill = `<span class="${CTR}" style="width:80%;height:${HGT};border-radius:${R}px;box-shadow:inset 0 0 0 1.5px ${color}"></span>`;
            cells += `${cellOpen(ds, ds)}${fill}<span class="${NUM} font-normal" style="color:${colorDark}">${d}</span>${cellClose(ds)}`;
          } else if (scheduled && !future && !beforeActive) {
            // missed (past, active, scheduled, not done) — light tint, discrete tile
            const fill = `<span class="${CTR}" style="width:80%;height:${HGT};background:${tint};border-radius:10px"></span>`;
            cells += `${cellOpen(ds, ds + ' · missed')}${fill}<span class="${NUM} font-normal" style="color:${colorDark}">${d}</span>${cellClose(ds)}`;
          } else {
            // before-created / future / rest day — no fill, legible-but-subordinate
            // gray. The ONLY state that uses gray (never a global default).
            cells += `<div class="relative flex aspect-square items-center justify-center text-sm font-normal tabular-nums text-slate-500 dark:text-slate-400">${d}</div>`;
          }
        }

        const arrowBtn = (dir, attr) => `<button ${attr} aria-label="${dir === 'prev' ? 'Previous' : 'Next'} month"
            class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="${dir === 'prev' ? 'M15.75 19.5 8.25 12l7.5-7.5' : 'm8.25 4.5 7.5 7.5-7.5 7.5'}"/></svg>
          </button>`;

        const legendItems = streak
          ? `<span class="flex items-center gap-1.5"><span class="inline-block h-3 w-6 rounded-full" style="background:${color}"></span>Clean</span>
             <span class="flex items-center gap-1.5"><span class="inline-block h-3.5 w-3.5 rounded" style="background:${SLIP_COLOR}"></span>Slip</span>`
          : `<span class="flex items-center gap-1.5"><span class="inline-block h-3 w-6 rounded-full" style="background:${color}"></span>Streak</span>
             <span class="flex items-center gap-1.5"><span class="inline-block h-3.5 w-3.5 rounded" style="background:${tint}"></span>Missed</span>
             <span class="flex items-center gap-1.5"><span class="inline-block h-3.5 w-3.5 rounded" style="box-shadow:inset 0 0 0 1.5px ${color}"></span>Today</span>`;
        const legend = `<div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] text-slate-500 dark:text-slate-400">${legendItems}</div>`;

        // Cap the calendar footprint (~70% of full width) so the tiles are ~30%
        // more compact. Cells shrink uniformly; inner-tile percentages are
        // unchanged, so connected done-tiles stay 100%-of-cell and still touch.
        return `
          <div class="mx-auto max-w-[420px]">
            <div class="mb-3 flex items-center justify-between">
              ${arrowBtn('prev', `data-cal-prev="${habit.id}"`)}
              <span class="text-sm font-semibold">${monthLabel}</span>
              ${atCurrent ? '<span class="h-8 w-8" aria-hidden="true"></span>' : arrowBtn('next', `data-cal-next="${habit.id}"`)}
            </div>
            <div class="grid grid-cols-7 gap-x-0">${wdRow}</div>
            <div class="mt-1 grid grid-cols-7 gap-x-0 gap-y-[5px]">${cells}</div>
            ${legend}
          </div>`;
      }

      // Habits of the same kind as `id`, in live order (reorder stays within a tab).
      function sameKindList(id) {
        const h0 = habits.find((h) => h.id === id);
        return h0 ? habits.filter((h) => isStreak(h) === isStreak(h0)) : [];
      }
      // up/down mover; disabled at the list ends (idx among same-kind siblings)
      function reorderBtn(dir, id) {
        const sib = sameKindList(id);
        const idx = sib.findIndex((h) => h.id === id);
        const disabled = dir === 'up' ? idx <= 0 : idx >= sib.length - 1;
        // full arrows (with stem) read as "move", distinct from the collapse chevron
        const path = dir === 'up' ? 'M12 19.5V4.5m0 0L6.75 9.75M12 4.5l5.25 5.25' : 'M12 4.5v15m0 0 5.25-5.25M12 19.5 6.75 14.25';
        return `<button ${disabled ? 'disabled' : `data-move="${dir}" data-habit-move="${id}"`} aria-label="Move ${dir}"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 text-slate-500 transition hover:bg-slate-50 disabled:opacity-30 disabled:hover:bg-transparent dark:border-slate-700 dark:text-slate-400 dark:hover:bg-slate-800">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="${path}"/></svg>
          </button>`;
      }

      // ---- expanded panel: overview (calendar) + optional stats -------------
      function overviewPanel(habit) {
        const s = stats(habit);
        const cell = (label, val) => `
          <div class="rounded-xl bg-slate-50 px-3 py-2.5 text-center dark:bg-slate-800/50">
            <div class="text-lg font-bold tabular-nums">${val}</div>
            <div class="text-[11px] font-medium text-slate-500 dark:text-slate-400">${label}</div>
          </div>`;

        const streak = isStreak(habit);
        const statCells = streak
          ? cell('Streak', s.current) + cell('Best', s.longest) + cell('Clean', s.total) + cell('Slips', s.slips)
          : cell('Streak', s.current) + cell('Best', s.longest) + cell('Total', s.total) + cell('30-day', s.rate30 + '%');

        // Controls (reorder / edit / delete) sit at the TOP of the expanded panel
        // so they're reachable without scrolling past the calendar + graph. (Trial
        // placement — was previously at the bottom.)
        const controls = viewing ? '' : `<div class="mb-5 flex items-center justify-between gap-2">
              <div class="flex items-center gap-1.5">
                ${reorderBtn('up', habit.id)}
                ${reorderBtn('down', habit.id)}
              </div>
              <div class="flex items-center gap-1.5">
                <button data-edit="${habit.id}" class="flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931z"/></svg>Edit</button>
                <button data-delete="${habit.id}" aria-label="Delete habit" title="Delete" class="flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 text-rose-500 transition hover:border-rose-200 hover:bg-rose-50 dark:border-slate-700 dark:text-rose-400 dark:hover:border-rose-900 dark:hover:bg-rose-950/40">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.16-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.04-2.09 1.02-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/></svg></button>
              </div>
            </div>`;

        return `
          <div class="mt-5 border-t border-slate-100 pt-5 dark:border-slate-800">
            ${controls}
            ${calendarGrid(habit)}
            <div class="mt-6 grid grid-cols-4 gap-2">
              ${statCells}
            </div>
            <div class="mt-5">${streak ? streakGraph(habit) : githubGraph(habit)}</div>
          </div>`;
      }

      // ---- habit card: week strip (collapsed) / calendar (expanded), both kinds --
      function habitCard(h) {
        const s = stats(h);
        const isOpen = expanded.has(h.id);
        const color = COLORS[h.color] || COLORS.emerald;
        // Expanded detail view drops the week strip (the month calendar below
        // covers those days); the strip stays only on the collapsed cards.
        const nameBtn = `
          <button data-toggle="${h.id}" class="flex w-full min-w-0 items-center gap-2 py-1.5 pr-2 text-left">
            <span class="shrink-0 text-base">${escapeHtml(h.emoji)}</span>
            <span class="truncate font-medium">${escapeHtml(h.name)}</span>
            ${s.current > 0 ? `<span class="inline-flex shrink-0 items-center gap-0.5 rounded-full px-1.5 py-0.5 text-[11px] font-semibold tabular-nums" style="color:${color};background:${color}14" title="${s.current}-day ${isStreak(h) ? 'clean streak' : 'streak'}">${FLAME}${s.current}</span>` : ''}
            <svg class="ml-auto h-4 w-4 shrink-0 text-slate-300 transition ${isOpen ? 'rotate-180' : ''} dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/></svg>
          </button>`;
        return `
        <article class="rounded-2xl bg-white px-4 py-2.5 shadow-sm ring-1 ring-black/5 transition dark:bg-slate-900 dark:ring-white/10">
          ${isOpen
            ? nameBtn + overviewPanel(h)
            : `<div class="${GRID}"><div class="col-span-7 cursor-pointer sm:col-span-1" data-toggle="${h.id}">${nameBtn}</div>${weekCells(h)}</div>`}
        </article>`;
      }

      const kindTabs = document.getElementById('kind-tabs');
      const addBottom = document.getElementById('add-btn-bottom');
      const addBottomLabel = document.getElementById('add-btn-bottom-label');
      function renderTabs() {
        [...kindTabs.children].forEach((b) => {
          const on = b.dataset.tab === activeTab;
          b.className = `rounded-lg py-2 transition ${on
            ? 'bg-white text-slate-900 shadow-sm dark:bg-slate-700 dark:text-white'
            : 'text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200'}`;
        });
      }

      function render() {
        renderTabs();
        const streakTab = activeTab === 'streak';
        const shown = habits.filter((h) => isStreak(h) === streakTab);
        const has = shown.length > 0;

        // Today-card shows on both tabs (habits + quit rings); renderTodayCard
        // decides its own visibility from the data. The week strip header follows `has`.
        weekHead.classList.toggle('hidden', !has);

        // The add button's visibility is set once in enterApp() (read-only can't
        // change without a reload); only its label depends on the active tab.
        addBottomLabel.textContent = streakTab ? 'Track a quit' : 'Add a habit';

        document.getElementById('empty-state').classList.toggle('hidden', has);
        if (!has) {
          document.getElementById('empty-title').textContent = viewing
            ? 'Nothing here yet'
            : (streakTab ? 'Track a quit streak' : 'Start your first habit');
          document.getElementById('empty-sub').textContent = viewing
            ? `${viewing.name} hasn’t added any ${streakTab ? 'streaks' : 'habits'} yet.`
            : (streakTab
                ? 'Quitting something? Track your clean streak — it counts up on its own every day, unless you mark a slip.'
                : 'Track something you want to do regularly — check it off with one tap a day.');
        }

        weekHeader();
        list.innerHTML = shown.map(habitCard).join('');
        renderTodayCard();
      }

      // Small progress ring: ordered color segments drawn from 12 o'clock over a
      // faint track. `gap` (path units) inserts a rounded break between segments
      // (the quit ring uses it to separate clean from slip). Geometry matches the
      // rest of the app (r=15.5, stroke 4).
      const RING_GREEN = COLORS.emerald, RING_SLIP = SLIP_COLOR;
      function ringSvg(segments, gap = 0) {
        const C = 2 * Math.PI * 15.5;
        let start = 0, arcs = '';
        for (const s of segments) {
          const len = Math.max(0, s.frac * C - gap);
          if (len > 0.01) {
            arcs += `<circle cx="18" cy="18" r="15.5" fill="none" stroke="${s.color}" stroke-width="4"${gap ? ' stroke-linecap="round"' : ''} stroke-dasharray="${len} ${C - len}" stroke-dashoffset="${-(start + gap / 2)}" style="transition:stroke-dashoffset .5s ease"/>`;
          }
          start += s.frac * C;
        }
        return `<svg class="h-12 w-12 -rotate-90 sm:h-14 sm:w-14" viewBox="0 0 36 36"><circle cx="18" cy="18" r="15.5" fill="none" class="stroke-slate-100 dark:stroke-slate-800" stroke-width="4"/>${arcs}</svg>`;
      }
      function ringBlock(svg, center, title, sub) {
        return `<div>
            <div class="relative mx-auto h-12 w-12 sm:h-14 sm:w-14">${svg}<span class="absolute inset-0 flex items-center justify-center text-xs font-semibold tabular-nums sm:text-sm">${center}</span></div>
            <div class="mt-1 text-center text-[11px] font-semibold leading-tight text-slate-500 dark:text-slate-400">${title}<span class="mt-px hidden text-[10px] font-medium text-slate-400 dark:text-slate-500 sm:block">${sub}</span></div>
          </div>`;
      }

      // Two-track daily summary: habits done/due today + quits clean/slipped today.
      // Each ring shows only if its track has something today; card hides if neither.
      function renderTodayCard() {
        const card = document.getElementById('today-card');
        const todayDow = dow(TODAY);
        const quits = habits.filter(isStreak);
        const due = habits.filter((h) => !isStreak(h) && schedOf(h).has(todayDow));
        const done = due.filter((h) => h.days.includes(TODAY)).length;
        const slip = quits.filter((h) => h.days.includes(TODAY)).length;
        const clean = quits.length - slip;

        const showHabits = due.length > 0, showQuits = quits.length > 0;
        card.classList.toggle('hidden', !showHabits && !showQuits);
        if (!showHabits && !showQuits) return;

        let rings = '';
        if (showHabits) rings += ringBlock(ringSvg([{ frac: done / due.length, color: RING_GREEN }]), `${done}/${due.length}`, 'Habits', 'done today');
        if (showQuits) rings += ringBlock(ringSvg([
          { frac: clean / quits.length, color: RING_GREEN },
          { frac: slip / quits.length, color: RING_SLIP },
        ], 1.5), `${clean}/${quits.length}`, 'Quit', 'clean today');
        document.getElementById('today-rings').innerHTML = rings;

        let text, cls;
        if (slip > 0) { text = `${slip} slip${slip > 1 ? 's' : ''} today`; cls = 'text-red-500 dark:text-red-400'; }
        else if (showHabits && done < due.length) { const left = due.length - done; text = `${left} habit${left > 1 ? 's' : ''} to go`; cls = 'text-slate-500 dark:text-slate-400'; }
        else { text = showQuits ? 'All clean · keep going' : 'All done today'; cls = 'text-emerald-600 dark:text-emerald-400'; }
        const statusEl = document.getElementById('today-status');
        statusEl.textContent = text;
        statusEl.className = 'mt-1 text-sm font-semibold ' + cls;
      }

      // ---- interactions ------------------------------------------------------
      list.addEventListener('click', async (e) => {
        const dayBtn = e.target.closest('.day');
        if (dayBtn) {
          if (viewing) return; // read-only: never write to a shared profile
          const id = Number(dayBtn.dataset.habit);
          const day = dayBtn.dataset.day;
          const habit = habits.find((h) => h.id === id);
          // optimistic toggle
          const has = habit.days.includes(day);
          habit.days = has ? habit.days.filter((d) => d !== day) : [...habit.days, day];
          render(); persist();
          try {
            await api('/api/checkins', { method: 'POST', body: { habitId: id, day } });
          } catch { /* keep optimistic state */ }
          return;
        }
        const toggle = e.target.closest('[data-toggle]');
        if (toggle) {
          const id = Number(toggle.dataset.toggle);
          if (expanded.has(id)) expanded.delete(id);
          else expanded.add(id);
          render();
          return;
        }
        const calPrev = e.target.closest('[data-cal-prev]');
        if (calPrev) {
          const id = Number(calPrev.dataset.calPrev);
          const v = getCalView(id);
          let m = v.m - 1, y = v.y;
          if (m < 0) { m = 11; y--; }        // roll back across the year
          calView.set(id, { y, m });
          render();
          return;
        }
        const calNext = e.target.closest('[data-cal-next]');
        if (calNext) {
          const id = Number(calNext.dataset.calNext);
          const v = getCalView(id);
          let m = v.m + 1, y = v.y;
          if (m > 11) { m = 0; y++; }         // roll forward across the year
          const t = new Date(TODAY + 'T00:00:00');
          if (y > t.getFullYear() || (y === t.getFullYear() && m > t.getMonth())) return; // never past current month
          calView.set(id, { y, m });
          render();
          return;
        }
        const del = e.target.closest('[data-delete]');
        if (del) {
          const id = Number(del.dataset.delete);
          const habit = habits.find((h) => h.id === id);
          askConfirm('Delete habit?', `This permanently deletes “${habit ? habit.name : 'this habit'}” and all its check-ins. This can't be undone.`, () => doDelete(id));
          return;
        }
        const edit = e.target.closest('[data-edit]');
        if (edit) {
          const habit = habits.find((h) => h.id === Number(edit.dataset.edit));
          if (habit) enterEditMode(habit);
          return;
        }
        const move = e.target.closest('[data-move]');
        if (move) {
          moveHabit(Number(move.dataset.habitMove), move.dataset.move);
          return;
        }
      });

      // ---- reorder (within the same kind; sort_order is one global space) -----
      function moveHabit(id, dir) {
        const sib = sameKindList(id);
        const si = sib.findIndex((h) => h.id === id);
        const sj = dir === 'up' ? si - 1 : si + 1;
        if (si < 0 || sj < 0 || sj >= sib.length) return;
        const a = habits.indexOf(sib[si]);
        const b = habits.indexOf(sib[sj]);
        [habits[a], habits[b]] = [habits[b], habits[a]];
        render(); persist();
        api('/api/habits/reorder', { method: 'POST', body: { ids: habits.map((h) => h.id) } });
      }

      async function doDelete(id) {
        habits = habits.filter((h) => h.id !== id);
        expanded.delete(id);
        render(); persist();
        await api('/api/habits/' + id, { method: 'DELETE' });
      }

      // ---- reusable confirmation modal --------------------------------------
      const confirmModal = document.getElementById('confirm-modal');
      const confirmOk = document.getElementById('confirm-ok');
      let onConfirmYes = null;
      function showConfirm() { confirmModal.classList.remove('hidden'); confirmModal.classList.add('flex'); }
      function hideConfirm() { confirmModal.classList.add('hidden'); confirmModal.classList.remove('flex'); onConfirmYes = null; }
      // askConfirm(title, text, fn, { okLabel = 'Delete', danger = true })
      const OK_DANGER = 'bg-rose-500 hover:bg-rose-600';
      const OK_NEUTRAL = 'bg-emerald-500 hover:bg-emerald-600';
      function askConfirm(title, text, fn, opts = {}) {
        document.getElementById('confirm-title').textContent = title;
        document.getElementById('confirm-text').textContent = text;
        confirmOk.textContent = opts.okLabel || 'Delete';
        confirmOk.className = `h-10 flex-1 rounded-xl text-sm font-semibold text-white transition active:scale-95 ${opts.danger === false ? OK_NEUTRAL : OK_DANGER}`;
        onConfirmYes = fn;
        showConfirm();
      }
      document.getElementById('confirm-cancel').addEventListener('click', hideConfirm);
      confirmModal.addEventListener('click', (e) => { if (e.target === confirmModal) hideConfirm(); });
      confirmOk.addEventListener('click', async () => {
        const fn = onConfirmYes;
        hideConfirm();
        if (fn) await fn();
      });

      // ---- add habit ---------------------------------------------------------
      let selectedColor = 'emerald';
      const picker = document.getElementById('color-picker');
      // selected = a ring in the swatch's own color with a white (theme-aware) gap
      const SWATCH_SEL = ['scale-110', 'ring-2', 'ring-offset-2', 'ring-offset-white', 'dark:ring-offset-slate-900'];
      picker.innerHTML = Object.entries(COLORS).map(([name, hex]) => `
        <button type="button" data-color="${name}" aria-label="${name}"
          class="h-7 w-7 rounded-full transition ${name === selectedColor ? SWATCH_SEL.join(' ') : ''}"
          style="background:${hex};--tw-ring-color:${hex}"></button>`).join('');
      function setColor(name) {
        selectedColor = name;
        [...picker.children].forEach((c) => {
          const on = c.dataset.color === selectedColor;
          SWATCH_SEL.forEach((cls) => c.classList.toggle(cls, on));
        });
      }
      picker.addEventListener('click', (e) => {
        const b = e.target.closest('[data-color]');
        if (!b) return;
        setColor(b.dataset.color);
      });

      // emoji picker: click the box to open a searchable grid of suggestions
      const emojiInput = document.getElementById('habit-emoji');
      const emojiPop = document.getElementById('emoji-pop');
      const emojiGrid = document.getElementById('emoji-grid');
      const emojiSearch = document.getElementById('emoji-search');
      const emojiNone = document.getElementById('emoji-none');
      // Render the grid, optionally filtered by a query (all query tokens must
      // appear in an emoji's keywords). Empty query shows the full list.
      function renderEmojiGrid(q = '') {
        const toks = q.trim().toLowerCase().split(/\s+/).filter(Boolean);
        const list = toks.length ? EMOJIS.filter(([, kw]) => toks.every((t) => kw.includes(t))) : EMOJIS;
        emojiGrid.innerHTML = list.map(([e]) =>
          `<button type="button" data-emoji="${e}" class="flex h-9 items-center justify-center rounded-lg text-xl transition hover:bg-slate-100 dark:hover:bg-slate-800">${e}</button>`).join('');
        emojiNone.classList.toggle('hidden', list.length > 0);
      }
      renderEmojiGrid();
      const showEmojiPop = (show) => {
        const willShow = show ?? emojiPop.classList.contains('hidden');
        emojiPop.classList.toggle('hidden', !willShow);
        if (willShow) { emojiSearch.value = ''; renderEmojiGrid(); }   // fresh list each open
      };
      emojiInput.addEventListener('click', (e) => { e.stopPropagation(); showEmojiPop(); });
      emojiSearch.addEventListener('input', () => renderEmojiGrid(emojiSearch.value));
      emojiGrid.addEventListener('click', (e) => {
        const b = e.target.closest('[data-emoji]');
        if (!b) return;
        emojiInput.value = b.dataset.emoji;
        showEmojiPop(false);
      });
      document.addEventListener('click', (e) => { if (!emojiPop.contains(e.target) && e.target !== emojiInput) showEmojiPop(false); });

      // ---- frequency selector ------------------------------------------------
      let freqMode = 'daily';                      // 'daily' | 'weekdays' | 'custom'
      let customDays = new Set([1, 2, 3, 4, 5]);   // JS weekday numbers
      const DAY_CHIPS = [[1, 'M'], [2, 'T'], [3, 'W'], [4, 'T'], [5, 'F'], [6, 'S'], [0, 'S']];
      const seg = document.getElementById('freq-seg');
      const daysBox = document.getElementById('freq-days');

      function currentSchedule() {
        if (freqMode === 'daily') return [0, 1, 2, 3, 4, 5, 6];
        if (freqMode === 'weekdays') return [1, 2, 3, 4, 5];
        return [...customDays];
      }
      function renderFreq() {
        const opts = [['daily', 'Every day'], ['weekdays', 'Weekdays'], ['custom', 'Custom']];
        seg.innerHTML = opts.map(([v, l]) => `
          <button type="button" data-freq="${v}"
            class="rounded-lg px-3 py-1.5 text-xs font-semibold transition ${freqMode === v
              ? 'bg-emerald-500 text-white shadow-sm'
              : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'}">${l}</button>`).join('');
        daysBox.classList.toggle('hidden', freqMode !== 'custom');
        daysBox.classList.toggle('flex', freqMode === 'custom');
        if (freqMode === 'custom') {
          daysBox.innerHTML = DAY_CHIPS.map(([n, l]) => `
            <button type="button" data-day-toggle="${n}"
              class="h-8 w-8 rounded-full text-xs font-semibold transition ${customDays.has(n)
                ? 'bg-emerald-500 text-white'
                : 'bg-slate-100 text-slate-500 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700'}">${l}</button>`).join('');
        }
      }
      seg.addEventListener('click', (e) => {
        const b = e.target.closest('[data-freq]');
        if (!b) return;
        freqMode = b.dataset.freq;
        renderFreq();
      });
      daysBox.addEventListener('click', (e) => {
        const b = e.target.closest('[data-day-toggle]');
        if (!b) return;
        const n = Number(b.dataset.dayToggle);
        customDays.has(n) ? customDays.delete(n) : customDays.add(n);
        if (customDays.size === 0) customDays.add(n); // keep at least one
        renderFreq();
      });
      renderFreq();

      // ---- add / edit habit (one form, two modes) ----------------------------
      let editingId = null;                       // null = create mode
      let formKind = 'normal';                    // 'normal' | 'streak' (create only)
      let startSel = null;                        // null | offset days (neg) | 'custom'
      const habitForm = document.getElementById('habit-form');
      const habitNameInput = document.getElementById('habit-name');
      const habitSubmit = document.getElementById('habit-submit');
      const formHeading = document.getElementById('form-heading');
      const freqSection = document.getElementById('freq-section');
      const startRow = document.getElementById('start-row');
      const startSeg = document.getElementById('start-seg');
      const startCustom = document.getElementById('start-custom');
      const startLabel = document.getElementById('start-label');

      // Reflect a habit's schedule back into the frequency selector.
      function setFreqFromHabit(h) {
        const key = [...schedOf(h)].sort((a, b) => a - b).join(',');
        if (key === '0,1,2,3,4,5,6') freqMode = 'daily';
        else if (key === '1,2,3,4,5') freqMode = 'weekdays';
        else { freqMode = 'custom'; customDays = new Set(key.split(',').map(Number)); }
        renderFreq();
      }

      // Backdated-start presets. First chip means "no backdate": for a normal habit
      // that's "None" (no existing streak); for a streak it's "Today" (clean from now).
      function renderStartSeg() {
        startLabel.textContent = formKind === 'streak' ? 'Clean since' : 'Existing streak?';
        const presets = [[null, formKind === 'streak' ? 'Today' : 'None'], [-7, '1 week'], [-14, '2 weeks'], [-30, '1 month'], ['custom', 'Custom']];
        startSeg.innerHTML = presets.map(([v, l]) => `
          <button type="button" data-start="${v}" class="rounded-lg px-3 py-1.5 text-xs font-semibold transition ${String(startSel) === String(v)
            ? 'bg-emerald-500 text-white shadow-sm'
            : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'}">${l}</button>`).join('');
        startCustom.classList.toggle('hidden', startSel !== 'custom');
      }
      startSeg.addEventListener('click', (e) => {
        const b = e.target.closest('[data-start]');
        if (!b) return;
        const v = b.dataset.start;
        startSel = v === 'null' ? null : (v === 'custom' ? 'custom' : Number(v));
        renderStartSeg();
      });
      // Resolve the chosen start into a YYYY-MM-DD (or null = no backdate).
      function computeStartDate() {
        if (startSel === 'custom') {
          const v = startCustom.value;
          if (/^\d{4}-\d{2}-\d{2}$/.test(v) && v <= TODAY) return v;
          return formKind === 'streak' ? TODAY : null;
        }
        if (startSel === null) return formKind === 'streak' ? TODAY : null;
        return addDays(TODAY, startSel);            // negative offset → a past date
      }

      // The create form's kind follows the active tab (no in-form toggle). Streaks
      // are daily (no frequency picker) and use a "Clean since" backdate.
      function setFormKind(kind) {
        formKind = kind;
        formHeading.textContent = kind === 'streak' ? 'Quit something' : 'Build a habit';
        freqSection.classList.toggle('hidden', kind === 'streak');
        startSel = null;
        renderStartSeg();
      }

      function resetFormToCreate() {
        editingId = null;
        habitNameInput.value = '';
        emojiInput.value = '✅';
        habitSubmit.textContent = 'Add';
        formHeading.classList.remove('hidden');
        startRow.classList.remove('hidden');
        setColor('emerald');
        freqMode = 'daily'; customDays = new Set([1, 2, 3, 4, 5]); renderFreq();
        setFormKind(activeTab === 'streak' ? 'streak' : 'normal');   // the open tab decides
      }
      function enterEditMode(h) {
        editingId = h.id;
        emojiInput.value = h.emoji;
        habitNameInput.value = h.name;
        setColor(COLORS[h.color] ? h.color : 'emerald');
        setFreqFromHabit(h);
        habitSubmit.textContent = 'Save';
        // Kind + start are set at creation; editing tweaks name/emoji/color/schedule.
        formHeading.textContent = isStreak(h) ? 'Edit streak' : 'Edit habit';
        startRow.classList.add('hidden');
        freqSection.classList.toggle('hidden', isStreak(h));
        habitForm.classList.remove('hidden');
        habitForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
        habitNameInput.focus();
      }

      habitForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = habitNameInput.value.trim();
        if (!name) return;
        const body = { name, emoji: emojiInput.value.trim() || '✅', color: selectedColor, schedule: currentSchedule() };
        if (editingId) {
          const { ok, data } = await api('/api/habits/' + editingId, { method: 'PATCH', body });
          if (ok) {
            const h = habits.find((x) => x.id === editingId);
            if (h) Object.assign(h, data);
            resetFormToCreate();
            habitForm.classList.add('hidden');
            render(); persist();
          }
        } else {
          body.kind = formKind;
          const sd = computeStartDate();
          if (sd) body.startDate = sd;
          const { ok, data } = await api('/api/habits', { method: 'POST', body });
          if (ok) {
            habits.push(data);
            // Jump to the tab the new tracker lives in so it's visible.
            if (isStreak(data) !== (activeTab === 'streak')) setTab(isStreak(data) ? 'streak' : 'normal');
            resetFormToCreate();
            habitForm.classList.add('hidden');
            render(); persist();
          }
        }
      });

      // Main tab switcher (Habits / Streaks).
      kindTabs.addEventListener('click', (e) => {
        const b = e.target.closest('[data-tab]');
        if (!b || b.dataset.tab === activeTab) return;
        setTab(b.dataset.tab);
        if (!habitForm.classList.contains('hidden')) { resetFormToCreate(); habitForm.classList.add('hidden'); }
        render();
      });
      document.getElementById('habit-close').addEventListener('click', () => { resetFormToCreate(); habitForm.classList.add('hidden'); });

      function openCreateForm() {
        resetFormToCreate();
        habitForm.classList.remove('hidden');
        habitForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
        habitNameInput.focus();
      }
      // header + button toggles a fresh "create" form (absent in a public view)
      document.getElementById('add-btn')?.addEventListener('click', () => {
        if (habitForm.classList.contains('hidden')) openCreateForm();
        else habitForm.classList.add('hidden');
      });
      // permanent bottom button — same fresh "create" form
      addBottom.addEventListener('click', openCreateForm);

      // ---- PWA service worker ------------------------------------------------
      // Registering the SW (+ manifest) is what makes the browser offer its own
      // install affordance beside the URL bar. We intentionally have no in-app
      // install button — we rely on the browser's native install icon.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }

      // ---- iOS install hint (Safari only; dismissible, shown once) ----------
      const iosHint = document.getElementById('ios-install');
      const IOS_HINT_KEY = 'habitrack_ios_hint';
      function maybeShowIosHint() {
        const ua = navigator.userAgent || '';
        const isIOS = /iphone|ipad|ipod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        const standalone = navigator.standalone === true || matchMedia('(display-mode: standalone)').matches;
        if (!isIOS || standalone || localStorage.getItem(IOS_HINT_KEY) === 'dismissed') return;
        iosHint.classList.remove('hidden');
        requestAnimationFrame(() => iosHint.classList.remove('translate-y-4', 'opacity-0'));
      }
      document.getElementById('ios-install-close').addEventListener('click', () => {
        iosHint.classList.add('translate-y-4', 'opacity-0');
        localStorage.setItem(IOS_HINT_KEY, 'dismissed');
        setTimeout(() => iosHint.classList.add('hidden'), 300);
      });

      // ---- data loading ------------------------------------------------------
      const loadError = document.getElementById('load-error');

      // Returns 'ok' | 'unauthorized' | 'forbidden' | 'error'
      async function fetchHabits() {
        try {
          const url = viewing ? `/api/habits?profile=${viewing.id}` : '/api/habits';
          const { ok, status, data } = await api(url);
          if (status === 401) return 'unauthorized';
          if (status === 403) return 'forbidden'; // share was revoked
          if (!ok) return 'error';
          habits = data;
          return 'ok';
        } catch { return 'error'; }
      }

      // The header (logo, date, account chip + menu, theme, presence) is the
      // shared <AppHeader> component; here we only own the app body + view banner.
      const addBtn = document.getElementById('add-btn');
      const viewBanner = document.getElementById('view-banner');
      function enterApp() {
        loadError.classList.add('hidden');
        if (readOnly()) {
          // Banner on, every add/edit affordance off. (The account chip is hidden by
          // AppHeader.) Nothing needs undoing in the writable case — the SSR markup
          // already renders in that state.
          document.getElementById('view-banner-name').textContent = viewing.name;
          viewBanner.classList.remove('hidden'); viewBanner.classList.add('flex');
          addBtn?.classList.add('hidden');
          addBottom.classList.add('hidden'); addBottom.classList.remove('flex');
          document.getElementById('habit-form').classList.add('hidden');
        }
        render();
        initRealtime();
        // Don't pitch "install Habitrack" to someone browsing a public profile or the
        // demo — installing would drop them on the login gate, not where they are.
        if (!publicView && !demoMode) setTimeout(maybeShowIosHint, 1200); // let content paint first
      }

      // Cookie-authed same-origin fetch — no localStorage token needed (an
      // installed PWA often has none). Reload on a day rollover so dates are fresh.
      async function refresh() {
        if (iso(new Date()) !== TODAY) { location.reload(); return; }
        if (demoMode) return; // nothing on the server to reconcile with
        const r = await fetchHabits();
        if (r === 'ok') { render(); loadError.classList.add('hidden'); }
        else if (r === 'unauthorized') { signOut(); }
        else if (r === 'forbidden') { exitViewMode(); } // access was revoked
      }
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') refresh();
      });
      window.addEventListener('pageshow', (e) => { if (e.persisted) refresh(); });

      function signOut() {
        token = ''; localStorage.removeItem(TK);
        location.href = '/profile';
      }

      // Leave read-only view of a shared profile (reload to rebind realtime). A
      // public view has nothing stored to clear, so it just leaves the page.
      function exitViewMode() {
        if (publicView) { location.href = '/profile'; return; }
        localStorage.removeItem(VIEW);
        location.reload();
      }
      document.getElementById('view-exit').addEventListener('click', exitViewMode);

      // Demo reset: drop the sandbox and reload, which re-seeds from #initial-habits.
      document.getElementById('demo-reset')?.addEventListener('click', () => {
        askConfirm('Reset the demo?', 'This clears the habits and check-ins you changed here and starts over from the sample data.', () => {
          clearDemo();
          location.reload();
        }, { okLabel: 'Reset', danger: false });
      });

      // ---- realtime: apply another device's change surgically ---------------
      function applyRemote(p) {
        if (!p || !p.type) return;
        if (p.type === 'checkin') {
          const h = habits.find((x) => x.id === p.habitId);
          if (!h) return;
          const has = h.days.includes(p.day);
          if (p.checked && !has) h.days = [...h.days, p.day];
          else if (!p.checked && has) h.days = h.days.filter((d) => d !== p.day);
          else return;
        } else if (p.type === 'add') {
          if (p.habit && !habits.some((x) => x.id === p.habit.id)) habits.push(p.habit);
          else return;
        } else if (p.type === 'delete') {
          if (!habits.some((x) => x.id === p.id)) return;
          habits = habits.filter((x) => x.id !== p.id);
          expanded.delete(p.id); calView.delete(p.id);
        } else if (p.type === 'update') {
          const h = habits.find((x) => x.id === p.habit.id);
          if (!h) return;
          Object.assign(h, p.habit); // days aren't in the payload, so they're preserved
        } else if (p.type === 'reorder') {
          const pos = new Map(p.ids.map((id, i) => [id, i]));
          habits.sort((a, b) => (pos.get(a.id) ?? 1e9) - (pos.get(b.id) ?? 1e9));
        } else return;
        render();
      }

      let realtimeStarted = false;
      async function initRealtime() {
        // Public views have no profile but do have a channel to watch — Pusher
        // channels are public (key + cluster only), so this works unauthenticated.
        // The demo has no server-side profile at all, so there's nothing to watch.
        if (realtimeStarted || demoMode || (!profile && !publicView)) return;
        realtimeStarted = true;
        try {
          const { ok, data: cfg } = await api('/api/rt-config');
          if (!ok || !cfg.enabled) return;
          const pusher = await connectRealtime({ key: cfg.key, cluster: cfg.cluster, channel: `habitrack-${dataId()}`, onEvent: applyRemote });
          const setId = () => { socketId = pusher.connection.socket_id; };
          pusher.connection.bind('connected', setId);
          if (pusher.connection.socket_id) setId();
        } catch { /* best-effort */ }
      }

      // ---- boot -------------------------------------------------------------
      // On the signed-in route middleware guarantees a valid session. Profile info
      // for the UI lives in localStorage; if it's missing we can't label things, so
      // bounce. A public view has no session by design and skips all of that.
      async function boot() {
        if (demoMode) {
          // Resume this visitor's sandbox if they've been here before, else start
          // from the SSR'd seed (which stays in the DOM as the reset target).
          habits = loadDemo() || initialHabits;
          enterApp();
          trackDemoVisit();
          return;
        }
        if (publicView) {
          // The SSR'd habits already belong to the viewed profile — render now.
          habits = initialHabits;
          enterApp();
          return;
        }
        if (viewing && !profile) { localStorage.removeItem(VIEW); viewing = null; }
        if (!profile) { location.href = '/profile'; return; }

        if (!viewing) {
          // own profile: render the SSR'd habits immediately, then reconcile.
          habits = initialHabits;
          enterApp();
          const r = await fetchHabits();
          if (r === 'ok') render();
          else if (r === 'unauthorized') signOut();
          return;
        }

        // view-mode: SSR data is our own, not the viewed profile — fetch it.
        let r = await fetchHabits();
        if (r === 'forbidden') { localStorage.removeItem(VIEW); viewing = null; habits = initialHabits; enterApp(); return; }
        if (r === 'ok') { enterApp(); return; }
        if (r === 'unauthorized') { location.href = '/profile'; return; }
        loadError.classList.remove('hidden'); // network error — keep shell, show error
      }
      boot();
    </script>
  </body>
</html>
